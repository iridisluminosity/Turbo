local totalAssets = #requiredSounds + #requiredIcons + #requiredAnimationFrames
local readyAssets = 0
local failedAssets = {}

local function prepareList(list, rawFolder, cacheFolder, kind)
    for _, item in ipairs(list) do
        local fileName = item[1]
        local label = item[2]
        local ok = ensureAsset(
            rawFolder .. fileName,
            cacheFolder .. fileName,
            kind .. "/" .. label
        )

        if ok then
            readyAssets += 1
        else
            table.insert(failedAssets, kind .. "/" .. label)
        end
    end
end

prepareList(
    requiredSounds,
    BASE .. "Sounds/",
    ROOT .. "/Sounds/",
    "Sound"
)

prepareList(
    requiredIcons,
    BASE .. "Images/",
    ROOT .. "/Images/Icons/",
    "Icon"
)

prepareList(
    requiredAnimationFrames,
    BASE .. "Images/Animations/LoadingAnimation/",
    ROOT .. "/Images/Animations/",
    "Animation"
)

