--[[ Turbo Loader / Asset Bootstrapper
     The Loader ONLY prepares and validates assets, then executes Main.
     Premium animations, sounds, button FX, tab FX and menu FX live in Main.
     Main is never written to disk.
]]

local Players = game:GetService("Players")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

local ROOT = "Turbo"
local BASE = "https://raw.githubusercontent.com/iridisluminosity/Turbo/refs/heads/main/"
local MAIN_URL = BASE .. "Developer/DevMain"

local DIRS = {
    ROOT,
    ROOT .. "/Sounds",
    ROOT .. "/Images",
    ROOT .. "/Images/Icons",
    ROOT .. "/Images/Animations",
    ROOT .. "/Configs",
}

for _, folder in ipairs(DIRS) do
    pcall(function()
        if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(folder) then
            makefolder(folder)
        end
    end)
end

local function httpGet(url)
    local ok, result = pcall(function()
        return game:HttpGet(url)
    end)
    return ok and result or nil
end

local function fileExists(path)
    local ok, result = pcall(function()
        return type(isfile) == "function" and isfile(path)
    end)
    return ok and result == true
end

local function writeFileSafe(path, data)
    if type(writefile) ~= "function" then
        return false
    end

    local ok = pcall(function()
        writefile(path, data)
    end)

    return ok and fileExists(path)
end

local function assetFromFile(path)
    local asset = nil

    pcall(function()
        if type(getcustomasset) == "function" then
            asset = getcustomasset(path)
        elseif type(getsynasset) == "function" then
            asset = getsynasset(path)
        end
    end)

    return type(asset) == "string" and #asset > 0 and asset or nil
end

local function ensureAsset(url, path, label)
    -- Existing file: validate it can be resolved as an asset.
    if fileExists(path) then
        local asset = assetFromFile(path)
        if asset then
            return true
        end

        -- Broken/empty/unresolvable cache entry: replace it.
        pcall(function()
            if type(delfile) == "function" then
                delfile(path)
            end
        end)
    end

    -- Download with a small retry budget.
    for attempt = 1, 3 do
        local data = httpGet(url)

        if type(data) == "string" and #data >= 20 then
            if writeFileSafe(path, data) then
                if assetFromFile(path) then
                    print("[Turbo Loader] OK:", label)
                    return true
                end
            end
        end

        task.wait(0.15 * attempt)
    end

    warn("[Turbo Loader] FAILED:", label)
    return false
end

