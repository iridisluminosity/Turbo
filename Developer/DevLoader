    totalAssets
))

-- =========================================================
-- MAIN FETCH + INTEGRITY CHECK
-- =========================================================

local function fnv1a(data)
    local h = 2166136261
    local bxor = bit32 and bit32.bxor
    if type(bxor) ~= "function" then
        return nil
    end

    for i = 1, #data do
        h = bxor(h, string.byte(data, i))
        h = (h * 16777619) % 4294967296
    end

    return string.format("%08x", h)
end

local function saneMain(data)
    return type(data) == "string"
        and #data >= 1000
        and #data <= 4000000
        and not data:find("\0", 1, true)
end

local mainCode = httpGet(MAIN_URL)
local manifest = httpGet(BASE .. "Configs/integrity.txt")
local expected = manifest and manifest:match("MAIN%s*=%s*([%x]+)")
local actual = mainCode and fnv1a(mainCode) or nil

if not saneMain(mainCode) then
    warn("[Turbo Loader] Main rejected by sanity check.")
    return
end

if expected and actual ~= string.lower(expected) then
    warn("[Turbo Loader] Main integrity mismatch. Execution aborted.")
    return
end

-- Main stays memory-only.
local fn, compileError = loadstring(mainCode)
mainCode = nil

if not fn then
    warn("[Turbo Loader] Main compile error:", compileError)
    return
end

local ok, err = pcall(fn)
if not ok then
    warn("[Turbo Loader] Main runtime error:", err)
    return
end

print("[Turbo Loader] Main executed. Premium runtime is owned by Main.")
