-- =========================================================
-- PROTECTED MAIN: MEMORY-ONLY
-- Main.lua is NEVER written to disk and there is no local fallback.
-- =========================================================

local function fnv1a(data)
    local h = 2166136261
    local bxor = bit32 and bit32.bxor
    if type(bxor) ~= "function" then return nil end
    for i = 1, #data do
        h = bxor(h, string.byte(data, i))
        h = (h * 16777619) % 4294967296
    end
    return string.format("%08x", h)
end

local function saneMain(data)
    return type(data) == "string"
        and #data >= 1000
        and #data <= 4000000
        and not data:find("\0", 1, true)
end

local function readIntegrityManifest()
    local manifest = httpGet(BASE .. "Configs/integrity.txt")
    if not manifest then return nil end
    local expected = manifest:match("MAIN%s*=%s*([%x]+)")
    return expected and string.lower(expected) or nil
end

local mainCode = httpGet(MAIN_URL)
local mainIntegrityExpected = readIntegrityManifest()
local mainIntegrityActual = mainCode and fnv1a(mainCode) or nil

if not saneMain(mainCode) then
    mainCode = nil
    warn("[Turbo] Main rejected by integrity sanity check.")
elseif mainIntegrityExpected and mainIntegrityActual ~= mainIntegrityExpected then
    warn("[Turbo] Main integrity mismatch; execution aborted.")
    mainCode = nil
end

