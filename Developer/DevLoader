local mainRunOK = false
local mainRunError = nil
local mainCompileError = nil

if mainCode then
    -- Basic runtime anti-tamper: fail closed if the execution primitives were replaced.
    local primitivesOK = type(loadstring) == "function"
        and type(pcall) == "function"
        and type(rawget) == "function"
        and type(task) == "table"
        and type(task.wait) == "function"

    if not primitivesOK then
        mainRunError = "Runtime integrity check failed."
        warn("[Turbo] Runtime integrity check failed.")
        mainCode = nil
    end
end

if mainCode then
    local fn, compileError = loadstring(mainCode)

    if not fn then
        mainCompileError = compileError
        warn("[Turbo] Main compile error:", compileError)
    else
        -- IMPORTANT: run Main synchronously. The previous versions started
        -- Main in task.spawn and then tried to find its GUI from a second
        -- thread. If Main failed or was still initializing, the premium
        -- layer could finish with only the loader visible.
        local ok, err = pcall(fn)
        mainRunOK = ok
        mainRunError = err

        if not ok then
            warn("[Turbo] Main runtime error:", err)
        end
    end
else
    warn("[Turbo] Could not load Main.")
end

