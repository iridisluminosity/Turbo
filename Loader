local function httpGet(url)
    local ok, result = pcall(function()
        return game:HttpGet(url)
    end)
    if ok and type(result) == "string" and #result > 0 then
        return result
    end

    local requestFn = nil
    pcall(function()
        requestFn = (syn and syn.request) or request or http_request
    end)

    if type(requestFn) == "function" then
        local rok, response = pcall(function()
            return requestFn({
                Url = url,
                Method = "GET",
            })
        end)
        if rok and type(response) == "table" then
            local body = response.Body or response.body
            if type(body) == "string" and #body > 0 then
                return body
            end
        end
    end

    warn("[Turbo] HTTP GET failed:", tostring(url))
    return nil
end
local function isFile(path)
    local ok, result = pcall(function()
        return isfile(path)
    end)
    return ok and result
end
local function writeSafe(path, data)
    pcall(function()
        writefile(path, data)
    end)
end
local function readSafe(path)
    local ok, result = pcall(function()
        return readfile(path)
    end)
    return ok and result or nil
end
local function customAsset(path)
    if getcustomasset then
        local ok, result = pcall(function()
            return getcustomasset(path)
        end)
        if ok then return result end
    end
    if getsynasset then
        local ok, result = pcall(function()
            return getsynasset(path)
        end)
        if ok then return result end
    end
end
local function cache(url, path)
    if not isFile(path) then
        local data = httpGet(url)
        if not data then return nil end
        writeSafe(path, data)
    end
    return customAsset(path)
end
local Sounds = {}
local function makeSound(name, fileName, volume)
    local path = ROOT .. "/Sounds/" .. fileName
    local asset = cache(BASE .. "Sounds/" .. fileName, path)
    if not asset then
        return nil
    end
    local sound = Instance.new("Sound")
    sound.Name = "TurboPremium_" .. name
    sound.SoundId = asset
    sound.Volume = volume or 0.35
    sound.Parent = SoundService
    return sound
end
local function getSound(name, preferred, fallback)
    if Sounds[name] then
        return Sounds[name]
    end
    local sound = makeSound(name, preferred, 0.32)
    if not sound and fallback then
        sound = makeSound(name, fallback, 0.25)
    end
    Sounds[name] = sound
    return sound
end
local function playSound(name, preferred, fallback, volume)
    local sound = getSound(name, preferred, fallback)
    if not sound then
        return
    end
    sound.Volume = volume or sound.Volume
    sound.TimePosition = 0
    pcall(function()
        sound:Play()
    end)
end
