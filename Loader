local function hookSwitchVisuals(obj)
    if not obj or not obj:IsA("GuiButton") then return end
    if obj:GetAttribute("TurboSwitchHooked") then return end

    local name = string.lower(obj.Name .. " " .. (obj:IsA("TextButton") and obj.Text or ""))

    if not (
        name:find("enable", 1, true)
        or name:find("disable", 1, true)
        or name:find("toggle", 1, true)
        or name:find("switch", 1, true)
        or name:find("lock", 1, true)
    ) then
        return
    end

    obj:SetAttribute("TurboSwitchHooked", true)

    obj.Activated:Connect(function()
        turboPlay("switch", "select.ogg", "click.ogg", 0.30)

        local scale = obj:FindFirstChild("TurboSwitchScale")
        if not scale then
            scale = Instance.new("UIScale")
            scale.Name = "TurboSwitchScale"
            scale.Parent = obj
        end

        TweenService:Create(
            scale,
            TweenInfo.new(0.07, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            {Scale = 0.95}
        ):Play()

        task.delay(0.07, function()
            if scale and scale.Parent then
                TweenService:Create(
                    scale,
                    TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                    {Scale = 1}
                ):Play()
            end
        end)
    end)
end

if turboGui then
    for _, obj in ipairs(turboGui:GetDescendants()) do
        hookSwitchVisuals(obj)
    end

    turboGui.DescendantAdded:Connect(function(obj)
        task.defer(function()
            hookSwitchVisuals(obj)
        end)
    end)
end

