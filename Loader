local function markTabPanels(gui)
    if not gui then return end

    for _, obj in ipairs(gui:GetDescendants()) do
        if (obj:IsA("Frame") or obj:IsA("ScrollingFrame"))
            and obj.AbsoluteSize.X >= 220
            and obj.AbsoluteSize.Y >= 100 then

            local name = string.lower(obj.Name)

            if name:find("character", 1, true)
                or name:find("aim", 1, true)
                or name:find("whitelist", 1, true)
                or name:find("settings", 1, true)
                or name:find("config", 1, true)
                or name:find("appearance", 1, true)
                or name:find("tab", 1, true)
                or name:find("content", 1, true)
                or name:find("page", 1, true) then

                obj:SetAttribute("TurboTabPanel", true)
            end
        end
    end
end

-- Animate panels whenever Main changes their visibility.
local tabBasePositions = setmetatable({}, {__mode = "k"})

local function getTabBasePosition(obj)
    local base = tabBasePositions[obj]
    if base == nil then
        base = obj.Position
        tabBasePositions[obj] = base
    end
    return base
end

local function animateTabPanel(obj)
    if not obj or not obj.Parent or not obj.Visible then return end

    local target = getTabBasePosition(obj)
    local scale = obj:FindFirstChild("TurboTabScale")

    if not scale then
        scale = Instance.new("UIScale")
        scale.Name = "TurboTabScale"
        scale.Parent = obj
    end

    -- Always start from the SAME base position. Never add the 12px offset
    -- to the panel's already-animated position. This prevents tab drift.
    obj.Position = target + UDim2.fromOffset(12, 0)
    scale.Scale = 0.985

    TweenService:Create(
        scale,
        TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        {Scale = 1}
    ):Play()

    TweenService:Create(
        obj,
        TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        {Position = target}
    ):Play()
end

local function hookTabPanel(obj)
    if not (obj:IsA("Frame") or obj:IsA("ScrollingFrame")) then
        return
    end

    if not obj:GetAttribute("TurboTabPanel") then
        return
    end

    if obj:GetAttribute("TurboTabVisibilityHooked") then
        return
    end

    obj:SetAttribute("TurboTabVisibilityHooked", true)
    tabBasePositions[obj] = obj.Position

    obj:GetPropertyChangedSignal("Visible"):Connect(function()
        if obj.Visible and turboGui and turboGui.Parent then
            animateTabPanel(obj)
        end
    end)
end

if turboGui then
    markTabPanels(turboGui)

    for _, obj in ipairs(turboGui:GetDescendants()) do
        if obj:IsA("GuiButton") then
            setupButton(obj)
        end
        hookTabPanel(obj)
    end

    turboGui.DescendantAdded:Connect(function(obj)
        task.defer(function()
            if not turboGui or not turboGui.Parent then return end

            if obj:IsA("GuiButton") then
                setupButton(obj)
            end

            if obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
                local size = obj.AbsoluteSize
                if size.X >= 220 and size.Y >= 100 then
                    local name = string.lower(obj.Name)
                    if name:find("character", 1, true)
                        or name:find("aim", 1, true)
                        or name:find("whitelist", 1, true)
                        or name:find("settings", 1, true)
                        or name:find("config", 1, true)
                        or name:find("appearance", 1, true)
                        or name:find("tab", 1, true)
                        or name:find("content", 1, true)
                        or name:find("page", 1, true) then
                        obj:SetAttribute("TurboTabPanel", true)
                    end
                end
                hookTabPanel(obj)
            end
        end)
    end)
end

