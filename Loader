local function animateMenuClose()
    if not turboGui or not turboGui.Parent then return end
    if menuBusy then return end

    menuBusy = true
    menuOpen = false

    local frame = mainFrame or findMainFrame(turboGui)
    local scale = setupMenuScale()

    turboPlay("menuClose", "gui_close.ogg", "click.ogg", 0.34)

    if frame and scale then
        local original = frame.Position

        TweenService:Create(
            scale,
            TweenInfo.new(0.20, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
            {Scale = 0.965}
        ):Play()

        TweenService:Create(
            frame,
            TweenInfo.new(0.20, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
            {Position = original + UDim2.fromOffset(0, 10)}
        ):Play()

        task.delay(0.21, function()
            if frame and frame.Parent then
                frame.Position = original
                scale.Scale = 1
            end
            if turboGui and turboGui.Parent and not menuOpen then
                turboGui.Enabled = false
            end
            menuBusy = false
        end)
    else
        turboGui.Enabled = false
        menuBusy = false
    end
end

local function toggleMenu()
    if not turboGui or not turboGui.Parent then return end

    local currentlyOpen = turboGui.Enabled == true
        and mainFrame ~= nil
        and mainFrame.Parent ~= nil
        and mainFrame.Visible == true

    if currentlyOpen then
        animateMenuClose()
    else
        animateMenuOpen()
    end
end

