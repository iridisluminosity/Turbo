local function collectRequestFunctions()
    local functions = {}
    local seen = {}
    local function addFunction(name, fn)
        if type(fn) ~= "function" then
            return
        end
        if seen[fn] then
            return
        end
        seen[fn] = true
        table.insert(functions, {
            name = name,
            fn = fn,
        })
    end
    pcall(function()
        if type(getgenv) == "function" then
            local env = getgenv()
            if type(env) == "table" then
                addFunction("getgenv.request", env.request)
                addFunction("getgenv.http_request", env.http_request)
            end
        end
    end)
    pcall(function()
        addFunction("request", request)
    end)
    pcall(function()
        addFunction("http_request", http_request)
    end)
    pcall(function()
        if type(syn) == "table" then
            addFunction("syn.request", syn.request)
        end
    end)
    return functions
end
local function getResponseStatus(result)
    if type(result) ~= "table" then
        return nil
    end
    return tonumber(
        result.StatusCode
        or result.statusCode
        or result.Status
        or result.status
    )
end
local function getResponseBody(result)
    if type(result) ~= "table" then
        return nil
    end
    local body = result.Body or result.body
    if body == nil then
        return nil
    end
    return tostring(body)
end
local function looksLikeInvalidGatewayKey(statusCode, responseBody)
    if statusCode ~= 401 then
        return false
    end
    local body = string.lower(responseBody or "")
    return body:find("unauthorized_invalid_api_key", 1, true) ~= nil
        or body:find("bad_checksum", 1, true) ~= nil
        or body:find("invalid api key", 1, true) ~= nil
end
local function requestVerifyKey(key, hwid, executor)
    local requestFunctions = collectRequestFunctions()
    if #requestFunctions == 0 then
        return nil, "HTTP request API was not found in this executor."
    end
    local body = HttpService:JSONEncode({
        key = key,
        hwid = hwid,
        executor = executor,
    })
    local lastError = nil
    for _, requestInfo in ipairs(requestFunctions) do
        local ok, result = pcall(function()
            return requestInfo.fn({
                Url = VERIFY_KEY_URL,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["apikey"] = SUPABASE_PUBLISHABLE_KEY,
                    ["Authorization"] = "Bearer " .. SUPABASE_PUBLISHABLE_KEY,
                },
                Body = body,
            })
        end)
        if ok and result then
            local statusCode = getResponseStatus(result)
            local responseBody = getResponseBody(result)
            if type(responseBody) == "string" and responseBody ~= "" then
                if not looksLikeInvalidGatewayKey(statusCode, responseBody) then
                    local decodeOK, decoded = pcall(function()
                        return HttpService:JSONDecode(responseBody)
                    end)
                    if decodeOK and type(decoded) == "table" then
                        return decoded
                    end
                    lastError = "The key server returned an invalid response."
                else
                    lastError = "The executor's HTTP bridge was rejected by the Supabase API key gateway."
                end
            else
                lastError = "The key server returned an empty response."
            end
        else
            lastError = "HTTP request failed through " .. requestInfo.name .. "."
        end
    end
    return nil, lastError or "Could not connect to the key server."
end
