local function verifyEnteredKey()
    if keyVerified or keyRequestBusy then
        return
    end
    local now = os.clock()
    local remaining = KEY_COOLDOWN - (now - lastKeyRequestAt)
    if remaining > 0 then
        setKeyError("Please wait " .. tostring(math.ceil(remaining)) .. "s before trying again.")
        setProgress(0.66, "REQUEST COOLDOWN")
        return
    end
    local enteredKey = tostring(keyBox.Text or "")
        :gsub("^%s+", "")
        :gsub("%s+$", "")
        :upper()
    if enteredKey == "" then
        setKeyError("Please enter a key.")
        return
    end
    local hwid, hwidError = getHWID()
    if not hwid then
        setKeyError(hwidError or "Could not get HWID from executor.")
        return
    end
    local executor = getExecutorName()
    keyRequestBusy = true
    lastKeyRequestAt = os.clock()
    verifyButton.Text = "CHECKING  ..."
    verifyButton.Active = false
    keyBox.Active = false
    setKeyError("")
    setProgress(0.66, "VERIFYING KEY")
    local response, requestError = requestVerifyKey(enteredKey, hwid, executor)
    keyRequestBusy = false
    verifyButton.Active = true
    keyBox.Active = true
    verifyButton.Text = "VERIFY  >"
    if not response then
        setKeyError(requestError or "Unable to contact the key server.")
        setProgress(0.66, "KEYSERVER ERROR")
        return
    end
    if response.success == true and response.valid == true
        and (response.code == "AUTHORIZED" or response.code == "KEY_REGISTERED") then
        keyVerified = true
        keyResult = response
        saveKey(enteredKey)
        local owner = tostring(response.owner_name or "User")
        keyTitle.Text = "ACCESS GRANTED"
        keySubtitle.Text = "Welcome, " .. owner .. "."
        setKeyError("")
        status.Text = "KEY VERIFIED"
        status.TextColor3 = Color3.fromRGB(90, 220, 130)
        setProgress(0.70, "KEY VERIFIED")
        playSound("select", "select.ogg", nil, 0.32)
        closeKeyGui(true)
    else
        local code = tostring(response.code or "UNKNOWN_ERROR")
        local messages = {
            INVALID_KEY = "This key does not exist.",
            KEY_DISABLED = "This key is disabled.",
            KEY_EXPIRED = "This key has expired.",
            HWID_MISMATCH = "This key is already registered to another HWID.",
            MISSING_KEY = "A key is required.",
            MISSING_HWID = "HWID is required.",
            SERVER_ERROR = "The key server encountered an error.",
        }
        setKeyError(messages[code] or tostring(response.message or "Key verification failed."))
        setProgress(0.66, "ACCESS DENIED")
        playSound("lock", "lock.ogg", "select.ogg", 0.30)
    end
end
