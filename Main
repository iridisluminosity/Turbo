	SubText = Color3.fromRGB(140, 140, 160),
	Accent = Color3.fromRGB(220, 55, 70),
	Green = Color3.fromRGB(70, 200, 120),
	Red = Color3.fromRGB(220, 70, 85),
}

local accentElements = {}
local toggleUpdaters = {}
local knobStrokes = {}
local lockKeyButtons = {}
local AllLists = {}
local AllBinds = {}
local OpenList = nil
local Binding = nil
local MenuOpen = true
local currentTab = nil
local Pages, TabBtns = {}, {}
local ScreenGui, Main, Top, TopLine, Title, StatusLbl

local ICON_BASE = "https://raw.githubusercontent.com/iridisluminosity/Turbo/main/Images/"
local ICON_FILES = {
	character = "character.png", aim_parts = "body_parts.png", whitelist = "hidden.png",
	settings = "config.png", config = "file_config.png", methods = "methods.png",
	aim = "aim.png", target = "target.png", crosshair = "crosshair.png",
	body_parts = "body_parts.png", prediction = "prediction.png", smooth = "smooth.png",
	delay = "delay.png", deadzone = "deadzone.png", hourglass = "hourglass.png",
	distance = "distance.png", shield = "shield.png", block = "block.png",
	keyboard = "keyboard.png", mouse = "mouse.png", bind = "bind.png",
	always = "always.png", priority = "priority.png", behind = "behind.png",
	panic = "panic.png", file = "file.png", info = "info.png", eye = "eye.png",
	contacts = "contacts.png", dashboard = "dashboard.png", console = "console.png",
}

local iconCache = {}
local function getIcon(name)
	if iconCache[name] ~= nil then return iconCache[name] end
	local file = ICON_FILES[name]
	if not file then iconCache[name] = false; return nil end
	local url = ICON_BASE .. file
	local ok, result = pcall(function()
		local folder = "TurboIcons"
		if type(isfolder) == "function" and type(makefolder) == "function" then
			if not isfolder(folder) then pcall(makefolder, folder) end
		end
		local path = folder .. "/" .. file
		local needDownload = true
		if type(isfile) == "function" and isfile(path) then
			needDownload = false
		end
		if needDownload then
			local data
			if type(request) == "function" then
				local res = request({Url = url, Method = "GET"})
				data = res and (res.Body or res.body)
			elseif type(http_request) == "function" then
				local res = http_request({Url = url, Method = "GET"})
				data = res and (res.Body or res.body)
			elseif type(syn) == "table" and type(syn.request) == "function" then
				local res = syn.request({Url = url, Method = "GET"})
				data = res and (res.Body or res.body)
			else
				data = game:HttpGet(url)
			end
			if not data or #data < 50 then return nil end
			if type(writefile) == "function" then
				writefile(path, data)
			else
				return nil
			end
		end
		if type(getcustomasset) == "function" then
			return getcustomasset(path)
		end
		if type(getsynasset) == "function" then
			return getsynasset(path)
		end
		return nil
	end)
	if ok and result and type(result) == "string" and #result > 0 then
		iconCache[name] = result
		return result
	end
	iconCache[name] = false
	return nil
end

local function New(c, p, parent)
	local o = Instance.new(c)
	for k, v in pairs(p or {}) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function Corner(p, r) return New("UICorner", {CornerRadius = UDim.new(0, r or 6)}, p) end
local function Stroke(p, c, t) return New("UIStroke", {Color = c or Theme.Stroke, Thickness = t or 1}, p) end
local function Tween(o, props, d)
	TweenService:Create(o, TweenInfo.new(d or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end
local function Label(parent, text, size, color, bold)
	return New("TextLabel", {
		BackgroundTransparency = 1, Text = text,
		TextColor3 = color or Theme.Text, TextSize = size or 13,
		Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
		BorderSizePixel = 0, TextTruncate = Enum.TextTruncate.AtEnd,
	}, parent)
end

local function closeLists()
	for _, l in ipairs(AllLists) do l.Visible = false end
	OpenList = nil
end

local function applyAccent(c)
	if typeof(c) ~= "Color3" then return end
	Theme.Accent = c
	if TopLine then TopLine.BackgroundColor3 = c end
	if Title then Title.TextColor3 = c end
	if currentTab and TabBtns[currentTab] then
		-- force refresh tab colors
		for n, b in pairs(TabBtns) do
			local on = n == currentTab
			local ic = b:FindFirstChild("IconImg")
			if ic and ic:IsA("ImageLabel") then
				ic.ImageColor3 = on and Theme.Accent or Theme.SubText
			end
		end
	end
	for _, p in pairs(Pages) do
		if p.sc then p.sc.ScrollBarImageColor3 = c end
	end
	for _, el in ipairs(accentElements) do
		if el and el.Parent then
			pcall(function()
				if el:IsA("ImageLabel") then
					el.ImageColor3 = c
				else
					el.BackgroundColor3 = c
				end
			end)
		end
	end
	for _, upd in ipairs(toggleUpdaters) do
		pcall(upd)
	end
	for _, stroke in ipairs(knobStrokes) do
		if stroke and stroke.Parent then
			pcall(function() stroke.Color = c end)
		end
	end
	for _, entry in ipairs(lockKeyButtons) do
		if entry.btn and entry.btn.Parent then
			local active = false
			for _, k in ipairs(Config.LockKeys) do
				if k == entry.key then active = true break end
			end
			pcall(function()
				entry.btn.BackgroundColor3 = active and Theme.Accent or Theme.Element
			end)
		end
	end
end

-- ============================================================
-- BUILD GUI (em função separada para não estourar registradores)
-- ============================================================
local function buildGUI()
	local old = PlayerGui:FindFirstChild("Turbo")
	if old then old:Destroy() end

	ScreenGui = New("ScreenGui", {
		Name = "Turbo", ResetOnSpawn = false, IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, PlayerGui)

	Main = New("Frame", {
		Size = UDim2.fromOffset(860, 560),
		Position = UDim2.new(0.5, -410, 0.5, -270),
		BackgroundColor3 = Theme.Bg, BorderSizePixel = 0,
		Active = true, ClipsDescendants = true,
	}, ScreenGui)
	Corner(Main, 12)
	Stroke(Main)

	Top = New("Frame", {
		Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = Theme.Panel, BorderSizePixel = 0, Active = true,
	}, Main)
	Corner(Top, 12)
	New("Frame", {Size = UDim2.new(1, 0, 0, 16), Position = UDim2.new(0, 0, 1, -16), BackgroundColor3 = Theme.Panel, BorderSizePixel = 0}, Top)
	TopLine = New("Frame", {Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0}, Top)

	Title = Label(Top, "Turbo", 20, Theme.Accent, true)
	Title.Position = UDim2.fromOffset(18, 0)
	Title.Size = UDim2.fromOffset(90, 52)
	local Sub = Label(Top, "🚀 ·  Character", 12, Theme.SubText)
	Sub.Position = UDim2.fromOffset(110, 0)
	Sub.Size = UDim2.fromOffset(260, 52)
	StatusLbl = Label(Top, "● ACTIVE", 12, Theme.Green, true)
	StatusLbl.Position = UDim2.new(1, -130, 0, 0)
	StatusLbl.Size = UDim2.fromOffset(115, 52)
	StatusLbl.TextXAlignment = Enum.TextXAlignment.Right

	local Side = New("Frame", {
		Size = UDim2.fromOffset(200, 568), Position = UDim2.fromOffset(0, 52),
		BackgroundColor3 = Theme.Panel, BorderSizePixel = 0,
	}, Main)
	New("Frame", {Size = UDim2.fromOffset(1, 568), Position = UDim2.new(1, -1, 0, 0), BackgroundColor3 = Theme.Stroke, BorderSizePixel = 0}, Side)
	local TabBox = New("Frame", {
		Size = UDim2.new(1, -14, 1, -18), Position = UDim2.fromOffset(7, 12), BackgroundTransparency = 1,
	}, Side)
	New("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder}, TabBox)

	local Content = New("Frame", {
		Size = UDim2.new(1, -200, 1, -52), Position = UDim2.fromOffset(200, 52),
		BackgroundTransparency = 1, ClipsDescendants = true,
	}, Main)

	local function makePage(name)
		local sc = New("ScrollingFrame", {
			Name = name, Size = UDim2.new(1, -18, 1, -18), Position = UDim2.fromOffset(9, 9),
			BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 5,
			ScrollBarImageColor3 = Theme.Accent, CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false, ClipsDescendants = true,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ElasticBehavior = Enum.ElasticBehavior.Never,
		}, Content)
		New("UIPadding", {
			PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 8),
			PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 14),
		}, sc)
		local row = New("Frame", {
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1, ClipsDescendants = false,
		}, sc)
		local L = New("Frame", {
			Name = "L", Size = UDim2.new(0.5, -7, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1, ClipsDescendants = false,
		}, row)
		New("UIListLayout", {Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder}, L)
		local R = New("Frame", {
			Name = "R", Size = UDim2.new(0.5, -7, 0, 0), Position = UDim2.new(0.5, 7, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ClipsDescendants = false,
		}, row)
		New("UIListLayout", {Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder}, R)
		Pages[name] = {sc = sc, L = L, R = R}
		return Pages[name]
	end

	local function selectTab(name)
		currentTab = name
		for n, p in pairs(Pages) do p.sc.Visible = (n == name) end
		for n, b in pairs(TabBtns) do
			local on = n == name
			b.BackgroundTransparency = on and 0 or 1
			b.BackgroundColor3 = Theme.Element
			local ind = b:FindFirstChild("Ind")
			if ind then ind.Visible = on end
			local ic = b:FindFirstChild("IconImg")
			if ic and ic:IsA("ImageLabel") then
				ic.ImageColor3 = on and Theme.Accent or Theme.SubText
			end
			local tx = b:FindFirstChild("TabText")
			if tx then tx.TextColor3 = on and Theme.Text or Theme.SubText end
		end
	end

	local function makeTab(name, iconName, order)
		local b = New("TextButton", {
			Size = UDim2.new(1, 0, 0, 62), BackgroundColor3 = Theme.Element,
			BackgroundTransparency = 1, BorderSizePixel = 0, Text = "", AutoButtonColor = false,
			LayoutOrder = order, Active = true,
		}, TabBox)
		Corner(b, 8)
		local ind = New("Frame", {
			Name = "Ind", Size = UDim2.fromOffset(4, 36), Position = UDim2.new(0, 0, 0.5, -18),
			BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Visible = false,
		}, b)
		Corner(ind, 2)
		table.insert(accentElements, ind)
		local asset = getIcon(iconName)
		if asset then
			New("ImageLabel", {
				Name = "IconImg", Size = UDim2.fromOffset(65, 65), Position = UDim2.fromOffset(8, 0),
				BackgroundTransparency = 1, Image = asset, ImageColor3 = Theme.SubText,
				ScaleType = Enum.ScaleType.Fit, ResampleMode = Enum.ResamplerMode.Default,
			}, b)
		else
			local fallback = Label(b, "●", 22, Theme.SubText, true)
			fallback.Name = "IconImg"
			fallback.Size = UDim2.fromOffset(50, 62)
			fallback.Position = UDim2.fromOffset(10, 0)
			fallback.TextXAlignment = Enum.TextXAlignment.Center
		end
		local tx = Label(b, name, 14, Theme.SubText, true)
		tx.Name = "TabText"
		tx.Position = UDim2.fromOffset(64, 0)
		tx.Size = UDim2.new(1, -72, 1, 0)
		b.Activated:Connect(function() selectTab(name) end)
		TabBtns[name] = b
	end

	makeTab("Character", "character", 1)
	makeTab("AimParts", "aim_parts", 2)
	makeTab("Whitelist", "whitelist", 3)
	makeTab("Settings", "settings", 4)
	makeTab("Config", "config", 5)

	local pCL = makePage("Character")
	local pAP = makePage("AimParts")
	local pWL = makePage("Whitelist")
	local pST = makePage("Settings")
	local pCF = makePage("Config")

	local function Card(parent, title, iconName)
		local f = New("Frame", {
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = Theme.Panel, BorderSizePixel = 0, ClipsDescendants = false,
		}, parent)
		Corner(f, 10)
		Stroke(f)
		local hdr = New("Frame", {Size = UDim2.new(1, 0, 0, 46), BackgroundTransparency = 1}, f)
		local asset = iconName and getIcon(iconName)
		local titleX = 14
		if asset then
			local ic = New("ImageLabel", {
				Size = UDim2.fromOffset(63, 63), Position = UDim2.fromOffset(11, -5),
				BackgroundTransparency = 1, Image = asset, ImageColor3 = Theme.Accent,
				ScaleType = Enum.ScaleType.Fit, ResampleMode = Enum.ResamplerMode.Default,
			}, hdr)
			table.insert(accentElements, ic)
			titleX = 56
		end
		local t = Label(hdr, title, 14, Theme.Text, true)
		t.Position = UDim2.fromOffset(titleX, 0)
		t.Size = UDim2.new(1, -titleX - 10, 1, 0)
		local accentLine = New("Frame", {
			Size = UDim2.new(1, -28, 0, 2), Position = UDim2.fromOffset(14, 44),
			BackgroundColor3 = Theme.Accent, BorderSizePixel = 0,
		}, hdr)
		table.insert(accentElements, accentLine)
		local body = New("Frame", {
			Size = UDim2.new(1, -18, 0, 0), Position = UDim2.fromOffset(9, 50),
			AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ClipsDescendants = false,
		}, f)
		New("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder}, body)
		New("UIPadding", {PaddingBottom = UDim.new(0, 10)}, body)
		return body
	end

	local function Toggle(parent, text, getter, setter)
		local row = New("Frame", {Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1}, parent)
		Label(row, text, 13, Theme.Text).Size = UDim2.new(1, -58, 1, 0)
		local btn = New("TextButton", {
			Size = UDim2.fromOffset(44, 24), Position = UDim2.new(1, -44, 0.5, -12),
			BackgroundColor3 = Theme.Element, BorderSizePixel = 0, Text = "", AutoButtonColor = false,
		}, row)
		Corner(btn, 12)
		local cir = New("Frame", {
			Size = UDim2.fromOffset(16, 16), Position = UDim2.fromOffset(4, 4),
			BackgroundColor3 = Theme.SubText, BorderSizePixel = 0,
		}, btn)
		Corner(cir, 8)
		local function upd()
			local on = getter()
			if on then
				Tween(btn, {BackgroundColor3 = Theme.Accent})
				Tween(cir, {Position = UDim2.new(1, -20, 0, 4), BackgroundColor3 = Color3.new(1,1,1)})
			else
				Tween(btn, {BackgroundColor3 = Theme.Element})
				Tween(cir, {Position = UDim2.fromOffset(4, 4), BackgroundColor3 = Theme.SubText})
			end
		end
		upd()
		btn.Activated:Connect(function() setter(not getter()); upd() end)
		table.insert(toggleUpdaters, upd)
	end

	local function Slider(parent, text, min, max, dec, getter, setter)
		dec = dec or 1
		local row = New("Frame", {Size = UDim2.new(1, 0, 0, 52), BackgroundTransparency = 1}, parent)
		Label(row, text, 13, Theme.Text).Size = UDim2.new(1, -70, 0, 20)
		local box = New("TextBox", {
			Size = UDim2.fromOffset(62, 20), Position = UDim2.new(1, -62, 0, 0),
			BackgroundColor3 = Theme.Element, TextColor3 = Theme.Text, Text = "",
			TextSize = 12, Font = Enum.Font.GothamMedium, ClearTextOnFocus = false, BorderSizePixel = 0,
		}, row)
		Corner(box, 5)
		local bar = New("Frame", {
			Size = UDim2.new(1, 0, 0, 12), Position = UDim2.fromOffset(0, 30),
			BackgroundColor3 = Theme.Element, BorderSizePixel = 0,
		}, row)
		Corner(bar, 4)
		local fill = New("Frame", {Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0}, bar)
		Corner(fill, 4)
		table.insert(accentElements, fill)
		local knob = New("Frame", {
			Size = UDim2.fromOffset(17, 17), AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, ZIndex = 2,
		}, bar)
		Corner(knob, 20)
		local stroke = New("UIStroke", {Color = Theme.Accent, Thickness = 2.5, Transparency = 0.25}, knob)
		table.insert(knobStrokes, stroke)
		local function fmt(v)
			if dec == 0 then return tostring(math.floor(v + 0.5)) end
			return string.format("%." .. dec .. "f", v)
		end
		local function setV(v, fire)
			v = math.clamp(v, min, max)
			if dec == 0 then v = math.floor(v + 0.5)
			else local m = 10 ^ dec; v = math.floor(v * m + 0.5) / m end
			local a = (max == min) and 0 or (v - min) / (max - min)
			fill.Size = UDim2.new(a, 0, 1, 0)
			knob.Position = UDim2.new(a, 0, 0.5, 0)
			box.Text = fmt(v)
			if fire then setter(v) end
		end
		setV(getter(), false)
		local drag = false
		local function fromMouse()
			local mx = UserInputService:GetMouseLocation().X
			local left = bar.AbsolutePosition.X
			local w = math.max(bar.AbsoluteSize.X, 1)
			setV(min + (max - min) * math.clamp((mx - left) / w, 0, 1), true)
		end
		bar.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true; fromMouse() end
		end)
		UserInputService.InputChanged:Connect(function(i)
			if drag and i.UserInputType == Enum.UserInputType.MouseMovement then fromMouse() end
		end)
		UserInputService.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
		end)
		box.FocusLost:Connect(function()
			local n = tonumber(box.Text)
			if n then setV(n, true) else setV(getter(), false) end
		end)
	end

	local function Dropdown(parent, text, options, getter, setter)
		local row = New("Frame", {
			Size = UDim2.new(1, 0, 0, 54), BackgroundTransparency = 1, ZIndex = 20, ClipsDescendants = false,
		}, parent)
		Label(row, text, 13, Theme.Text).Size = UDim2.new(1, 0, 0, 20)
		local btn = New("TextButton", {
			Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 22),
			BackgroundColor3 = Theme.Element, Text = "  " .. tostring(getter()),
			TextColor3 = Theme.Text, TextSize = 12, Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 21,
		}, row)
		Corner(btn, 6)
		local listH = math.min(#options * 28, 168)
		local list = New("Frame", {
			Size = UDim2.fromOffset(220, listH), BackgroundColor3 = Theme.Panel2,
			BorderSizePixel = 0, Visible = false, ZIndex = 300, ClipsDescendants = true,
		}, ScreenGui)
		Corner(list, 6)
		Stroke(list)
		New("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, list)
		table.insert(AllLists, list)
		local function place()
			local ap, as = btn.AbsolutePosition, btn.AbsoluteSize
			list.Size = UDim2.fromOffset(math.max(as.X, 180), listH)
			local vy = camera.ViewportSize.Y
			local y = ap.Y + as.Y + 4
			if y + listH > vy then y = ap.Y - listH - 4 end
			list.Position = UDim2.fromOffset(ap.X, math.clamp(y, 0, math.max(0, vy - listH)))
		end
		for i, opt in ipairs(options) do
			local o = New("TextButton", {
				Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1,
				Text = "  " .. tostring(opt), TextColor3 = Theme.Text, TextSize = 12,
				Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
				AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = i, ZIndex = 301,
			}, list)
			o.Activated:Connect(function()
				setter(opt)
				btn.Text = "  " .. tostring(getter())
				closeLists()
			end)
			o.MouseEnter:Connect(function() o.BackgroundTransparency = 0; o.BackgroundColor3 = Theme.Element end)
			o.MouseLeave:Connect(function() o.BackgroundTransparency = 1 end)
		end
		btn.Activated:Connect(function()
			if list.Visible then closeLists()
			else closeLists(); place(); list.Visible = true; OpenList = list end
		end)
	end

	local function Bind(parent, text, getter, setter)
		local row = New("Frame", {Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, ZIndex = 30}, parent)
		Label(row, text, 13, Theme.Text).Size = UDim2.new(1, -110, 1, 0)
		local btn = New("TextButton", {
			Size = UDim2.fromOffset(100, 28), Position = UDim2.new(1, -100, 0.5, -14),
			BackgroundColor3 = Theme.Element, Text = getter().Name, TextColor3 = Theme.Text,
			TextSize = 12, Font = Enum.Font.GothamMedium, AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 31,
		}, row)
		Corner(btn, 6)
		btn.Activated:Connect(function()
			if Binding == btn then Binding = nil; btn.Text = getter().Name; btn.TextColor3 = Theme.Text
			else Binding = btn; btn.Text = "..."; btn.TextColor3 = Theme.Accent end
		end)
		table.insert(AllBinds, {btn = btn, getter = getter, setter = setter})
	end

	local AIM_OPTS = {"Root", "Head", "AboveHead", "Torso", "Front", "Back", "Left", "Right", "LeftArm", "RightArm"}

	-- Character
	do
		local cM = Card(pCL.L, "Methods", "methods")
		Dropdown(cM, "Rotate Method",
			{"CFrame", "Align", "Align2", "BodyGyro", "AngularVel", "Torque", "Motor6D", "Assembly"},
			function() return Config.RotateMode end, function(v) Config.RotateMode = v end)

		local cD = Card(pCL.L, "Deadzone", "deadzone")
		Slider(cD, "Deadzone (deg)", 0, 180, 0, function() return Config.TurnDeadzoneDegrees end, function(v) Config.TurnDeadzoneDegrees = v end)
		Toggle(cD, "Zero While Holding", function() return Config.ZeroDeadzoneWhenHolding end, function(v) Config.ZeroDeadzoneWhenHolding = v end)

		local cP = Card(pCL.L, "Prediction", "prediction")
		Toggle(cP, "Enabled", function() return Config.UsePrediction end, function(v) Config.UsePrediction = v end)
		Slider(cP, "Strength", 0, 1, 3, function() return Config.PredictionStrength end, function(v) Config.PredictionStrength = v end)
		Slider(cP, "Max Speed", 1, 300, 0, function() return Config.PredictionMaxSpeed end, function(v) Config.PredictionMaxSpeed = v end)
		Slider(cP, "History Smooth", 1, 60, 0, function() return Config.PredictionHistorySmoothing end, function(v) Config.PredictionHistorySmoothing = v end)

		local cS = Card(pCL.R, "Smooth", "smooth")
		Slider(cS, "Aim Smooth", 0, 0.99, 2, function() return Config.AimSmooth end, function(v) Config.AimSmooth = v end)
		Toggle(cS, "Smooth Turn", function() return Config.UseSmoothTurn end, function(v) Config.UseSmoothTurn = v end)
		Slider(cS, "Turn Time", 0.01, 1, 3, function() return Config.Smoothness end, function(v) Config.Smoothness = v end)

		local cDe = Card(pCL.R, "Delay / Behind", "delay")
		Slider(cDe, "Behind Hold Delay", 0, 2, 2, function() return Config.BehindHoldDelay end, function(v) Config.BehindHoldDelay = v end)
		Slider(cDe, "Behind Distance", 0, 20, 1, function() return Config.BehindDistance end, function(v) Config.BehindDistance = v end)
		Slider(cDe, "Behind Smooth", 0, 0.5, 3, function() return Config.BehindSmoothTime end, function(v) Config.BehindSmoothTime = v end)
		Toggle(cDe, "Enable Teleport", function() return Config.EnableTeleport end, function(v) Config.EnableTeleport = v end)

		local cR = Card(pCL.R, "Retargets", "crosshair")
		Toggle(cR, "Block Retarget", function() return Config.BlockRetargetClosest end, function(v) Config.BlockRetargetClosest = v end)
		Toggle(cR, "Skill Retarget", function() return Config.SkillRetargetClosest end, function(v) Config.SkillRetargetClosest = v end)
		Toggle(cR, "Mouse Retarget", function() return Config.MouseRetargetClosest end, function(v) Config.MouseRetargetClosest = v end)
		Slider(cR, "Scan Interval", 0, 1, 3, function() return Config.UltraScanInterval end, function(v) Config.UltraScanInterval = v end)

		local cDi = Card(pCL.R, "Distance", "distance")
		Slider(cDi, "Min Lock Distance", 0, 100, 0, function() return Config.MinLockDistance end, function(v) Config.MinLockDistance = v end)
		Slider(cDi, "Max Lock Distance", 10, 1000, 0, function() return Config.MaxLockDistance end, function(v) Config.MaxLockDistance = v end)

		local cV = Card(pCL.L, "Validation", "shield")
		Toggle(cV, "Strong Validation", function() return Config.StrongValidation end, function(v) Config.StrongValidation = v end)
		Toggle(cV, "Instant Behind Snap", function() return Config.InstantBehindSnap end, function(v) Config.InstantBehindSnap = v end)
		Toggle(cV, "Ignore Active Counter", function() return Config.IgnoreActiveCounter end, function(v) Config.IgnoreActiveCounter = v end)
	end

	-- AimParts
	do
		local function aimCard(col, source, title, icon, keyGet, keySet)
			local c = Card(col, title, icon)
			if keyGet and keySet then
				Bind(c, "Key", keyGet, keySet)
			end
			Dropdown(c, "Aim Part", AIM_OPTS,
				function() return Config.AimPointBySource[source] or "Root" end,
				function(v) Config.AimPointBySource[source] = v end)
			Slider(c, "Offset", -10, 10, 2,
				function() return Config.AimOffsetBySource[source] or 0 end,
				function(v) Config.AimOffsetBySource[source] = v end)
		end

		aimCard(pAP.L, "block", "Block", "block",
			function() return Config.BlockKey or Enum.KeyCode.F end,
			function(v) Config.BlockKey = v end)
		aimCard(pAP.L, "skill", "Skill", "aim", nil, nil)
		aimCard(pAP.L, "mouse", "M1 (Mouse)", "mouse", nil, nil)
		aimCard(pAP.R, "q", "Behind", "behind",
			function() return Config.BehindKey end,
			function(v) Config.BehindKey = v end)
		aimCard(pAP.R, "priority", "Priority", "priority",
			function() return Config.PriorityKey end,
			function(v) Config.PriorityKey = v end)
		aimCard(pAP.R, "sticky", "Sticky", "always",
			function() return Config.StickyLockKey end,
			function(v) Config.StickyLockKey = v end)

		local cDef = Card(pAP.R, "Default / Above Head", "body_parts")
		Dropdown(cDef, "Default Aim Part", AIM_OPTS,
			function() return Config.AimPointBySource.default end,
			function(v) Config.AimPointBySource.default = v end)
		Slider(cDef, "Default Offset", -10, 10, 2,
			function() return Config.AimOffsetBySource.default end,
			function(v) Config.AimOffsetBySource.default = v end)
		Slider(cDef, "Above Head Height", 0, 5, 2,
			function() return Config.AboveHeadHeight end,
			function(v) Config.AboveHeadHeight = v end)
	end

	-- Whitelist
	do
		local cAlly = Card(pWL.L, "Ally Filter", "eye")
		Toggle(cAlly, "Whitelist Allies", function() return Config.IgnoreAllies.Enabled end, function(v) Config.IgnoreAllies.Enabled = v; rebuildAllyCache() end)
		Dropdown(cAlly, "Mode", {"UserId", "Name"},
			function() return Config.IgnoreAllies.UseUserId and "UserId" or "Name" end,
			function(v) Config.IgnoreAllies.UseUserId = (v == "UserId"); rebuildAllyCache() end)

		local cPl = Card(pWL.R, "Players in Server", "contacts")
		local plScroll = New("ScrollingFrame", {
			Size = UDim2.new(1, 0, 0, 320), BackgroundTransparency = 1, BorderSizePixel = 0,
			ScrollBarThickness = 4, ScrollBarImageColor3 = Theme.Accent,
			CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		}, cPl)
		New("UIListLayout", {Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.Name}, plScroll)

		local function isWL(plr)
			if Config.IgnoreAllies.UseUserId then
				for _, id in ipairs(Config.IgnoreAllies.UserIds) do if tonumber(id) == plr.UserId then return true end end
			else
				local w = string.lower(plr.Name)
				for _, n in ipairs(Config.IgnoreAllies.Names) do if string.lower(tostring(n)) == w then return true end end
			end
			return false
		end
		local function setWL(plr, val)
			if Config.IgnoreAllies.UseUserId then
				local ids = Config.IgnoreAllies.UserIds
				for i = #ids, 1, -1 do if tonumber(ids[i]) == plr.UserId then table.remove(ids, i) end end
				if val then table.insert(ids, plr.UserId) end
			else
				local names = Config.IgnoreAllies.Names
				for i = #names, 1, -1 do if string.lower(tostring(names[i])) == string.lower(plr.Name) then table.remove(names, i) end end
				if val then table.insert(names, plr.Name) end
			end
			rebuildAllyCache()
		end
		local function rebuildPL()
			for _, c in ipairs(plScroll:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= player then
					local on = isWL(plr)
					local b = New("TextButton", {
						Size = UDim2.new(1, -4, 0, 30), BackgroundColor3 = on and Color3.fromRGB(40, 70, 50) or Theme.Element,
						BorderSizePixel = 0, Text = "  " .. plr.Name .. (on and "  ✓" or ""),
						TextColor3 = Theme.Text, TextSize = 12, Font = Enum.Font.GothamMedium,
						TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false,
					}, plScroll)
					Corner(b, 6)
					b.Activated:Connect(function()
						setWL(plr, not isWL(plr))
						local now = isWL(plr)
						b.BackgroundColor3 = now and Color3.fromRGB(40, 70, 50) or Theme.Element
						b.Text = "  " .. plr.Name .. (now and "  ✓" or "")
					end)
				end
			end
		end
		rebuildPL()
		Players.PlayerAdded:Connect(rebuildPL)
		Players.PlayerRemoving:Connect(rebuildPL)
	end

	-- Settings
	do
		local cPrio = Card(pST.L, "Target Priority", "target")
		Dropdown(cPrio, "Priority", {"Players", "NPC", "Closest"},
			function() return Config.TargetPriority end, function(v) Config.TargetPriority = v end)

		local cKeys = Card(pST.L, "Hotkeys", "keyboard")
		Bind(cKeys, "Menu Key", function() return Config.ToggleKey end, function(v) Config.ToggleKey = v end)
		Bind(cKeys, "Enable Lock Key", function() return Config.EnableLockKey end, function(v) Config.EnableLockKey = v end)
		Bind(cKeys, "Panic Key", function() return Config.PanicKey end, function(v) Config.PanicKey = v end)
		Bind(cKeys, "Sticky Key", function() return Config.StickyLockKey end, function(v) Config.StickyLockKey = v end)
		Bind(cKeys, "Behind Key", function() return Config.BehindKey end, function(v) Config.BehindKey = v end)
		Bind(cKeys, "Priority Key", function() return Config.PriorityKey end, function(v) Config.PriorityKey = v end)

		local cTime = Card(pST.R, "Lock Timing", "hourglass")
		Slider(cTime, "Hold Threshold (skill key)", 0, 4, 2, function() return Config.HoldThreshold end, function(v) Config.HoldThreshold = v end)
		Slider(cTime, "Click Duration (skill)", 0, 4, 2, function() return Config.ClickLockDuration end, function(v) Config.ClickLockDuration = v end)
		Slider(cTime, "Hold Threshold (mouse)", 0, 4, 2, function() return Config.MouseHoldThreshold end, function(v) Config.MouseHoldThreshold = v end)
		Slider(cTime, "Click Duration (mouse)", 0, 4, 2, function() return Config.MouseClickLockDuration end, function(v) Config.MouseClickLockDuration = v end)

		local cLK = Card(pST.R, "Lock Keys", "bind")
		Toggle(cLK, "Use Mouse Button 1", function() return Config.UseMouseButton1 end, function(v) Config.UseMouseButton1 = v end)

		local keyRow = New("Frame", {Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1}, cLK)
		New("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder}, keyRow)
		local commons = {{Enum.KeyCode.One,"1"},{Enum.KeyCode.Two,"2"},{Enum.KeyCode.Three,"3"},{Enum.KeyCode.Four,"4"},{Enum.KeyCode.F,"F"},{Enum.KeyCode.E,"E"},{Enum.KeyCode.R,"R"},{Enum.KeyCode.G,"G"}}
		local function inLK(k)
			for _, x in ipairs(Config.LockKeys) do if x == k then return true end end
			return false
		end
		local function togLK(k)
			for i, x in ipairs(Config.LockKeys) do if x == k then table.remove(Config.LockKeys, i) return end end
			table.insert(Config.LockKeys, k)
		end
		for i, e in ipairs(commons) do
			local k, n = e[1], e[2]
			local b = New("TextButton", {
				Size = UDim2.fromOffset(38, 30), BackgroundColor3 = inLK(k) and Theme.Accent or Theme.Element,
				BorderSizePixel = 0, Text = n, TextColor3 = Theme.Text, TextSize = 13,
				Font = Enum.Font.GothamBold, AutoButtonColor = false, LayoutOrder = i,
			}, keyRow)
			Corner(b, 6)
			b.Activated:Connect(function()
				togLK(k)
				b.BackgroundColor3 = inLK(k) and Theme.Accent or Theme.Element
			end)
			table.insert(lockKeyButtons, {btn = b, key = k})
		end

		local cPanic = Card(pST.L, "Panic", "panic")
		local panicInfo = Label(cPanic, "Panic Key destroys the GUI and fully disables the lock until you re-execute the script.", 12, Theme.SubText)
		panicInfo.Size = UDim2.new(1, 0, 0, 44)
		panicInfo.TextWrapped = true
		panicInfo.TextYAlignment = Enum.TextYAlignment.Top

		local cTheme = Card(pST.R, "Appearance", "dashboard")
		-- ColorPicker simplificado
		local row = New("Frame", {Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1}, cTheme)
		Label(row, "Accent Color", 13, Theme.Text).Size = UDim2.new(1, -130, 1, 0)
		local swatch = New("TextButton", {
			Size = UDim2.fromOffset(32, 24), Position = UDim2.new(1, -122, 0.5, -12),
			BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Text = "", AutoButtonColor = false,
		}, row)
		Corner(swatch, 5)
		Stroke(swatch, Theme.Stroke, 1)
		local hex = New("TextBox", {
			Size = UDim2.fromOffset(84, 24), Position = UDim2.new(1, -84, 0.5, -12),
			BackgroundColor3 = Theme.Element, TextColor3 = Theme.Text, TextSize = 11,
			Font = Enum.Font.GothamMedium, ClearTextOnFocus = false, BorderSizePixel = 0,
			Text = string.format("%02X%02X%02X",
				math.floor(Theme.Accent.R*255+0.5), math.floor(Theme.Accent.G*255+0.5), math.floor(Theme.Accent.B*255+0.5)),
		}, row)
		Corner(hex, 5)

		local presets = {
			Color3.fromRGB(220, 55, 70),
			Color3.fromRGB(90, 120, 255),
			Color3.fromRGB(160, 80, 255),
			Color3.fromRGB(70, 200, 120),
			Color3.fromRGB(255, 160, 40),
			Color3.fromRGB(0, 200, 220),
			Color3.fromRGB(255, 80, 160),
			Color3.fromRGB(240, 240, 245),
		}
		local pop = New("Frame", {
			Size = UDim2.fromOffset(180, 76), BackgroundColor3 = Theme.Panel2,
			BorderSizePixel = 0, Visible = false, ZIndex = 320,
		}, ScreenGui)
		Corner(pop, 7)
		Stroke(pop)
		New("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Left,
			VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 5),
			SortOrder = Enum.SortOrder.LayoutOrder, Wraps = true,
		}, pop)
		New("UIPadding", {PaddingLeft = UDim.new(0, 7), PaddingTop = UDim.new(0, 7), PaddingRight = UDim.new(0, 7)}, pop)
		table.insert(AllLists, pop)

		local function setColor(c)
			Theme.Accent = c
			swatch.BackgroundColor3 = c
			hex.Text = string.format("%02X%02X%02X",
				math.floor(c.R*255+0.5), math.floor(c.G*255+0.5), math.floor(c.B*255+0.5))
			applyAccent(c)
			pop.Visible = false
		end
		for i, pc in ipairs(presets) do
			local b = New("TextButton", {
				Size = UDim2.fromOffset(20, 20), BackgroundColor3 = pc, BorderSizePixel = 0,
				Text = "", AutoButtonColor = false, LayoutOrder = i, ZIndex = 321,
			}, pop)
			Corner(b, 5)
			b.Activated:Connect(function() setColor(pc) end)
		end
		swatch.Activated:Connect(function()
			if pop.Visible then pop.Visible = false; return end
			closeLists()
			local ap = swatch.AbsolutePosition
			pop.Position = UDim2.fromOffset(ap.X - 40, ap.Y + 28)
			pop.Visible = true
			OpenList = pop
		end)
		hex.FocusLost:Connect(function()
			local t = hex.Text:gsub("#", "")
			if #t == 6 then
				local r = tonumber(t:sub(1,2), 16)
				local g = tonumber(t:sub(3,4), 16)
				local b = tonumber(t:sub(5,6), 16)
				if r and g and b then setColor(Color3.fromRGB(r,g,b)) end
			end
			hex.Text = string.format("%02X%02X%02X",
				math.floor(Theme.Accent.R*255+0.5), math.floor(Theme.Accent.G*255+0.5), math.floor(Theme.Accent.B*255+0.5))
		end)
	end

	-- Config
	do
		local function ser()
			local keys = {}
			for _, k in ipairs(Config.LockKeys) do table.insert(keys, k.Name) end
			return {
				RotateMode = Config.RotateMode, TurnDeadzoneDegrees = Config.TurnDeadzoneDegrees,
				ZeroDeadzoneWhenHolding = Config.ZeroDeadzoneWhenHolding, UsePrediction = Config.UsePrediction,
				PredictionStrength = Config.PredictionStrength, PredictionMaxSpeed = Config.PredictionMaxSpeed,
				PredictionHistorySmoothing = Config.PredictionHistorySmoothing,
				AimPointBySource = Config.AimPointBySource, AimOffsetBySource = Config.AimOffsetBySource,
				AboveHeadHeight = Config.AboveHeadHeight, AimSmooth = Config.AimSmooth,
				UseSmoothTurn = Config.UseSmoothTurn, Smoothness = Config.Smoothness,
				BehindHoldDelay = Config.BehindHoldDelay, BehindDistance = Config.BehindDistance,
				BehindSmoothTime = Config.BehindSmoothTime, EnableTeleport = Config.EnableTeleport,
				BlockRetargetClosest = Config.BlockRetargetClosest, SkillRetargetClosest = Config.SkillRetargetClosest,
				MouseRetargetClosest = Config.MouseRetargetClosest, UltraScanInterval = Config.UltraScanInterval,
				MinLockDistance = Config.MinLockDistance, MaxLockDistance = Config.MaxLockDistance,
				StrongValidation = Config.StrongValidation, InstantBehindSnap = Config.InstantBehindSnap,
				IgnoreActiveCounter = Config.IgnoreActiveCounter, TargetPriority = Config.TargetPriority,
				ToggleKey = Config.ToggleKey.Name, EnableLockKey = Config.EnableLockKey.Name,
				PanicKey = Config.PanicKey.Name, StickyLockKey = Config.StickyLockKey.Name,
				BehindKey = Config.BehindKey.Name, PriorityKey = Config.PriorityKey.Name,
				BlockKey = (Config.BlockKey or Enum.KeyCode.F).Name,
				HoldThreshold = Config.HoldThreshold, ClickLockDuration = Config.ClickLockDuration,
				MouseHoldThreshold = Config.MouseHoldThreshold, MouseClickLockDuration = Config.MouseClickLockDuration,
				UseMouseButton1 = Config.UseMouseButton1, LockKeys = keys,
				IgnoreAllies = Config.IgnoreAllies,
				Accent = {math.floor(Theme.Accent.R*255+0.5), math.floor(Theme.Accent.G*255+0.5), math.floor(Theme.Accent.B*255+0.5)},
			}
		end
		local function toKey(s)
			local ok, k = pcall(function() return Enum.KeyCode[s] end)
			return (ok and k) or Enum.KeyCode.Unknown
		end
		local function apply(data)
			if type(data) ~= "table" then return false end
			for k, v in pairs(data) do
				if k == "LockKeys" and type(v) == "table" then
					Config.LockKeys = {}
					for _, n in ipairs(v) do local kk = toKey(n); if kk ~= Enum.KeyCode.Unknown then table.insert(Config.LockKeys, kk) end end
				elseif k == "AimPointBySource" or k == "AimOffsetBySource" or k == "IgnoreAllies" then
					if type(v) == "table" then Config[k] = v end
				elseif type(Config[k]) == "EnumItem" or k:find("Key") then
					Config[k] = toKey(v)
				elseif Config[k] ~= nil then
					Config[k] = v
				end
			end
			if type(data.Accent) == "table" and #data.Accent >= 3 then
				applyAccent(Color3.fromRGB(data.Accent[1], data.Accent[2], data.Accent[3]))
			end
			rebuildAllyCache()
			return true
		end

		local cSave = Card(pCF.L, "Save / Load", "file")
		local stLbl = Label(cSave, "Status: ready", 12, Theme.SubText)
		stLbl.Size = UDim2.new(1, 0, 0, 20)
		local function mkBtn(parent, text, col, fn)
			local b = New("TextButton", {
				Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = col or Theme.Accent,
				BorderSizePixel = 0, Text = text, TextColor3 = Color3.new(1,1,1),
				TextSize = 13, Font = Enum.Font.GothamBold, AutoButtonColor = false,
			}, parent)
			Corner(b, 7)
			b.Activated:Connect(fn)
			return b
		end
		mkBtn(cSave, "Save Config", Theme.Accent, function()
			local ok, err = pcall(function()
				local json = HttpService:JSONEncode(ser())
				if type(writefile) == "function" then writefile("TurboLockConfig.json", json)
				elseif type(setclipboard) == "function" then setclipboard(json); error("no writefile — copied to clipboard") 
				else error("no writefile") end
			end)
			stLbl.Text = ok and "Status: saved" or ("Status: " .. tostring(err))
			stLbl.TextColor3 = ok and Theme.Green or Theme.Red
		end)
		mkBtn(cSave, "Load Config", Color3.fromRGB(160, 50, 60), function()
			local ok, err = pcall(function()
				if type(readfile) ~= "function" then error("no readfile") end
				local data = HttpService:JSONDecode(readfile("TurboLockConfig.json"))
				if not apply(data) then error("apply failed") end
			end)
			stLbl.Text = ok and "Status: loaded" or ("Status: " .. tostring(err))
			stLbl.TextColor3 = ok and Theme.Green or Theme.Red
		end)

		local cInfo = Card(pCF.R, "Info", "info")
		local info = Label(cInfo, "Icons load from GitHub (Turbo/Images).\n\nPanic Key fully kills the script GUI + lock.\n\nAim Parts: set part + offset per source.", 12, Theme.SubText)
		info.Size = UDim2.new(1, 0, 0, 120)
		info.TextWrapped = true
		info.TextYAlignment = Enum.TextYAlignment.Top
	end

	-- Drag
	do
		local dragging, start, spos
		Top.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; start = i.Position; spos = Main.Position end
		end)
		Top.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
		end)
		UserInputService.InputChanged:Connect(function(i)
			if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
				local d = i.Position - start
				Main.Position = UDim2.new(spos.X.Scale, spos.X.Offset + d.X, spos.Y.Scale, spos.Y.Offset + d.Y)
			end
		end)
	end

	for _, p in pairs(Pages) do
		p.sc:GetPropertyChangedSignal("CanvasPosition"):Connect(closeLists)
	end

	selectTab("Character")
end

buildGUI()

local function clearFocus()
	local f = UserInputService:GetFocusedTextBox()
	if f then pcall(function() f:ReleaseFocus() end) end
	pcall(function() GuiService.SelectedObject = nil end)
end

local function setMenu(v)
	MenuOpen = v
	if not v then
		closeLists()
		Binding = nil
		clearFocus()
		if ScreenGui then ScreenGui.Enabled = false end
	else
		if ScreenGui then ScreenGui.Enabled = true end
		clearFocus()
	end
end

local function doPanic()
	turboPanicked = true
	lockEnabled = false
	pcall(hardClearLock)
	pcall(clearSticky)
	pcall(function() setRotateEnabled(false) end)
	closeLists()
	if ScreenGui then
		ScreenGui.Enabled = false
		ScreenGui:Destroy()
	end
	print("[Turbo] PANIC — lock disabled, GUI destroyed. Re-execute script to restore.")
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if turboPanicked then return end

	if input.KeyCode == Config.PanicKey then
		doPanic()
		return
	end

	if input.KeyCode == Config.ToggleKey then
		setMenu(not MenuOpen)
		return
	end

	if Binding then
		if input.KeyCode == Enum.KeyCode.Escape then
			Binding.TextColor3 = Theme.Text
			for _, b in ipairs(AllBinds) do b.btn.Text = b.getter().Name end
			Binding = nil
			return
		end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			for _, b in ipairs(AllBinds) do
				if b.btn == Binding then b.setter(input.KeyCode); break end
			end
			Binding.Text = input.KeyCode.Name
			Binding.TextColor3 = Theme.Text
			Binding = nil
			clearFocus()
		end
	end
end)

onLockEnabledChanged = function(en)
	if StatusLbl then
		StatusLbl.Text = en and "● ACTIVE" or "● OFF"
		StatusLbl.TextColor3 = en and Theme.Green or Theme.Red
	end
end
onLockEnabledChanged(lockEnabled)

task.spawn(function()
	for name in pairs(ICON_FILES) do
		pcall(getIcon, name)
		task.wait()
	end
end)

print("Turbo GUI v5.1 | Unique Icons | AimParts | Accent | Reduced Pixelation | Panic=" .. Config.PanicKey.Name)
