-- Card
local function Card(parent, title)
    local frame = New("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        ClipsDescendants = false,
    }, parent)
    Corner(frame, 8)
    Stroke(frame, Theme.Stroke)
    local header = New("Frame", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundTransparency = 1,
    }, frame)
    local t = Label(header, title, 12, Theme.Text, true)
    t.Position = UDim2.fromOffset(12, 0)
    t.Size = UDim2.new(1, -24, 1, 0)
    New("Frame", {
        Size = UDim2.new(1, -24, 0, 1),
        Position = UDim2.fromOffset(12, 33),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
    }, header)
    local body = New("Frame", {
        Size = UDim2.new(1, -20, 0, 0),
        Position = UDim2.fromOffset(10, 40),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        ClipsDescendants = false,
    }, frame)
    New("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder}, body)
    New("UIPadding", {PaddingBottom = UDim.new(0, 10)}, body)
    return body
end

-- Toggle (switch style)
local function Toggle(parent, text, getter, setter)
    local row = New("Frame", {
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundTransparency = 1,
    }, parent)
    Label(row, text, 12, Theme.Text).Size = UDim2.new(1, -50, 1, 0)

    local btn = New("TextButton", {
        Size = UDim2.fromOffset(38, 20),
        Position = UDim2.new(1, -38, 0.5, -10),
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
    }, row)
    Corner(btn, 10)
    local circle = New("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.fromOffset(3, 3),
        BackgroundColor3 = Theme.SubText,
        BorderSizePixel = 0,
    }, btn)
    Corner(circle, 7)

    local function update()
        local on = getter()
        if on then
            Tween(btn, {BackgroundColor3 = Theme.Accent})
            Tween(circle, {Position = UDim2.new(1, -17, 0, 3), BackgroundColor3 = Color3.new(1,1,1)})
        else
            Tween(btn, {BackgroundColor3 = Theme.Element})
            Tween(circle, {Position = UDim2.fromOffset(3, 3), BackgroundColor3 = Theme.SubText})
        end
    end
    update()
    btn.Activated:Connect(function()
        setter(not getter())
        update()
    end)
    return {Refresh = update}
end

-- Slider
local function Slider(parent, text, min, max, decimals, getter, setter)
    decimals = decimals or 1
    local row = New("Frame", {
        Size = UDim2.new(1, 0, 0, 46),
        BackgroundTransparency = 1,
    }, parent)
    local title = Label(row, text, 12, Theme.Text)
    title.Size = UDim2.new(1, -60, 0, 18)

    local valueBox = New("TextBox", {
        Size = UDim2.fromOffset(54, 18),
        Position = UDim2.new(1, -54, 0, 0),
        BackgroundColor3 = Theme.Element,
        TextColor3 = Theme.Text,
        Text = "",
        TextSize = 11,
        Font = Enum.Font.GothamMedium,
        ClearTextOnFocus = false,
        BorderSizePixel = 0,
    }, row)
    Corner(valueBox, 4)

    local bar = New("Frame", {
        Size = UDim2.new(1, 0, 0, 5),
        Position = UDim2.fromOffset(0, 28),
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
    }, row)
    Corner(bar, 3)
    local fill = New("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
    }, bar)
    Corner(fill, 3)
    local knob = New("Frame", {
        Size = UDim2.fromOffset(10, 10),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = Theme.Text,
        BorderSizePixel = 0,
        ZIndex = 2,
    }, bar)
    Corner(knob, 5)

    local function fmt(v)
        if decimals == 0 then return tostring(math.floor(v + 0.5)) end
        local m = 10 ^ decimals
        return string.format("%." .. decimals .. "f", math.floor(v * m + 0.5) / m)
    end

    local function setVisual(v, fire)
        v = math.clamp(v, min, max)
        if decimals == 0 then v = math.floor(v + 0.5)
        else
            local m = 10 ^ decimals
            v = math.floor(v * m + 0.5) / m
        end
        local a = (max == min) and 0 or (v - min) / (max - min)
        fill.Size = UDim2.new(a, 0, 1, 0)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        valueBox.Text = fmt(v)
        if fire then setter(v) end
    end
    setVisual(getter(), false)

    local dragging = false
    local function fromMouse()
        local mx = UserInputService:GetMouseLocation().X
        local left = bar.AbsolutePosition.X
        local w = math.max(bar.AbsoluteSize.X, 1)
        local a = math.clamp((mx - left) / w, 0, 1)
        setVisual(min + (max - min) * a, true)
    end
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            fromMouse()
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            fromMouse()
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    valueBox.FocusLost:Connect(function()
        local n = tonumber(valueBox.Text)
        if n then setVisual(n, true) else setVisual(getter(), false) end
    end)
    return {Set = function(v) setVisual(v, true) end, Refresh = function() setVisual(getter(), false) end}
end

-- Dropdown (single open, high ZIndex, no clip)
local OpenDropdown = nil

local function CloseDropdown()
    if OpenDropdown then
        OpenDropdown.Visible = false
        OpenDropdown = nil
    end
end

local function Dropdown(parent, text, options, getter, setter)
    local row = New("Frame", {
        Size = UDim2.new(1, 0, 0, 48),
        BackgroundTransparency = 1,
        ZIndex = 20,
        ClipsDescendants = false,
    }, parent)
    local title = Label(row, text, 12, Theme.Text)
    title.Size = UDim2.new(1, 0, 0, 16)

    local btn = New("TextButton", {
        Size = UDim2.new(1, 0, 0, 28),
        Position = UDim2.fromOffset(0, 18),
        BackgroundColor3 = Theme.Element,
        Text = "  " .. tostring(getter()),
        TextColor3 = Theme.Text,
        TextSize = 11,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        ZIndex = 21,
        ClipsDescendants = false,
    }, row)
    Corner(btn, 5)

    local listH = math.min(#options * 26, 156)
    local list = New("ScrollingFrame", {
        Size = UDim2.new(1, 0, 0, listH),
        Position = UDim2.new(0, 0, 1, 4),
        BackgroundColor3 = Theme.Panel2,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 200,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.new(0, 0, 0, #options * 26),
        ClipsDescendants = true,
    }, btn)
    Corner(list, 5)
    Stroke(list, Theme.Stroke)
    New("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, list)

    for i, opt in ipairs(options) do
        local o = New("TextButton", {
            Size = UDim2.new(1, 0, 0, 26),
            BackgroundTransparency = 1,
            Text = "  " .. tostring(opt),
            TextColor3 = Theme.Text,
            TextSize = 11,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            AutoButtonColor = false,
            BorderSizePixel = 0,
            LayoutOrder = i,
            ZIndex = 201,
        }, list)
        o.Activated:Connect(function()
            setter(opt)
            btn.Text = "  " .. tostring(getter())
            CloseDropdown()
        end)
        o.MouseEnter:Connect(function()
            o.BackgroundTransparency = 0
            o.BackgroundColor3 = Theme.Element
        end)
        o.MouseLeave:Connect(function()
            o.BackgroundTransparency = 1
        end)
    end

    btn.Activated:Connect(function()
        if list.Visible then
            CloseDropdown()
        else
            CloseDropdown()
            list.Visible = true
            OpenDropdown = list
        end
    end)

    return {
        Refresh = function()
            btn.Text = "  " .. tostring(getter())
        end
    }
end

-- Keybind
local BindingBtn = nil
local function KeyName(k)
    if not k or k == Enum.KeyCode.Unknown then return "None" end
    return k.Name
end

local function Bind(parent, text, getter, setter)
    local row = New("Frame", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundTransparency = 1,
        ZIndex = 30,
    }, parent)
    Label(row, text, 12, Theme.Text).Size = UDim2.new(1, -100, 1, 0)

    local btn = New("TextButton", {
        Size = UDim2.fromOffset(95, 26),
        Position = UDim2.new(1, -95, 0.5, -13),
        BackgroundColor3 = Theme.Element,
        Text = KeyName(getter()),
        TextColor3 = Theme.Text,
        TextSize = 11,
        Font = Enum.Font.GothamMedium,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        ZIndex = 31,
    }, row)
    Corner(btn, 5)

    btn.Activated:Connect(function()
        if BindingBtn == btn then
            BindingBtn = nil
            btn.Text = KeyName(getter())
            btn.TextColor3 = Theme.Text
        else
            BindingBtn = btn
            btn.Text = "..."
            btn.TextColor3 = Theme.Accent
        end
    end)

    return {
        Refresh = function()
            if BindingBtn ~= btn then
                btn.Text = KeyName(getter())
                btn.TextColor3 = Theme.Text
            end
        end,
        _btn = btn,
        _getter = getter,
        _setter = setter,
    }
end

