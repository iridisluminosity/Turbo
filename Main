local infoLbl = Label(cInfo, "Configs are saved as JSON in the TurboConfigs folder (executor filesystem).\n\nIf writefile is unavailable, Save copies JSON to clipboard.\n\nAfter Load, some UI labels refresh automatically; reopen tabs if needed.", 11, Theme.SubText)
infoLbl.Size = UDim2.new(1, 0, 0, 120)
infoLbl.TextWrapped = true
infoLbl.TextYAlignment = Enum.TextYAlignment.Top

-- =====================================================
-- DRAG
-- =====================================================
do
    local dragging, dragStart, startPos
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
        end
    end)
    TopBar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local d = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
    end)
end

-- =====================================================
-- MENU STATE / FOCUS
-- =====================================================
local MenuOpen = true

local function ClearFocus()
    local f = UserInputService:GetFocusedTextBox()
    if f then pcall(function() f:ReleaseFocus() end) end
    pcall(function() GuiService.SelectedObject = nil end)
end

local function SetMenu(state)
    MenuOpen = state
    if not state then
        CloseDropdown()
        if BindingBtn then
            BindingBtn.TextColor3 = Theme.Text
            BindingBtn = nil
        end
        ClearFocus()
        ScreenGui.Enabled = false
    else
        ScreenGui.Enabled = true
        ClearFocus()
    end
end

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end

    if input.KeyCode == Config.ToggleKey then
        SetMenu(not MenuOpen)
        return
    end

    if BindingBtn then
        if input.KeyCode == Enum.KeyCode.Escape then
            BindingBtn.TextColor3 = Theme.Text
            for _, b in ipairs(AllBinds) do if b.Refresh then b.Refresh() end end
            BindingBtn = nil
            return
        end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            for _, b in ipairs(AllBinds) do
                if b._btn == BindingBtn then
                    b._setter(input.KeyCode)
                    break
                end
            end
            BindingBtn.Text = KeyName(input.KeyCode)
            BindingBtn.TextColor3 = Theme.Text
            BindingBtn = nil
            ClearFocus()
        end
    end
end)

-- Status from lock
onLockEnabledChanged = function(enabled)
    if enabled then
        StatusLbl.Text = "● ACTIVE"
        StatusLbl.TextColor3 = Theme.Green
    else
        StatusLbl.Text = "● OFF"
        StatusLbl.TextColor3 = Theme.Red
    end
end
onLockEnabledChanged(lockEnabled)

-- Default tab
SelectTab("CharacterLock")
SetMenu(true)

print("Turbo GUI v4 | Save/Load | " .. Config.ToggleKey.Name .. " = menu | " .. Config.EnableLockKey.Name .. " = lock")
