            TopLine.BackgroundColor3 = Theme.Accent
            for _, p in pairs(Pages) do
                p.page.ScrollBarImageColor3 = Theme.Accent
            end
            for _, btn in pairs(TabButtons) do
                local ind = btn:FindFirstChild("Indicator")
                if ind then ind.BackgroundColor3 = Theme.Accent end
            end
        end
    end)

-- =====================================================
-- CONFIG SAVE / LOAD
-- =====================================================
local SAVE_FOLDER = "TurboConfigs"
local SAVE_FILE = "TurboConfigs/default.json"

local function keyToStr(k)
    if typeof(k) == "EnumItem" then return k.Name end
    return tostring(k)
end
local function strToKey(s)
    local ok, k = pcall(function() return Enum.KeyCode[s] end)
    if ok and k then return k end
    return Enum.KeyCode.Unknown
end

local function serializeConfig()
    local lockKeyNames = {}
    for _, k in ipairs(Config.LockKeys) do
        table.insert(lockKeyNames, keyToStr(k))
    end
    return {
        RotateMode = Config.RotateMode,
        TurnDeadzoneDegrees = Config.TurnDeadzoneDegrees,
        ZeroDeadzoneWhenHolding = Config.ZeroDeadzoneWhenHolding,
        UsePrediction = Config.UsePrediction,
        PredictionStrength = Config.PredictionStrength,
        PredictionMaxSpeed = Config.PredictionMaxSpeed,
        PredictionHistorySmoothing = Config.PredictionHistorySmoothing,
        AimPointDefault = Config.AimPointBySource.default,
        AimOffsetDefault = Config.AimOffsetBySource.default,
        AboveHeadHeight = Config.AboveHeadHeight,
        AimSmooth = Config.AimSmooth,
        UseSmoothTurn = Config.UseSmoothTurn,
        Smoothness = Config.Smoothness,
        BehindHoldDelay = Config.BehindHoldDelay,
        BehindDistance = Config.BehindDistance,
        BehindSmoothTime = Config.BehindSmoothTime,
        EnableTeleport = Config.EnableTeleport,
        BlockRetargetClosest = Config.BlockRetargetClosest,
        SkillRetargetClosest = Config.SkillRetargetClosest,
        MouseRetargetClosest = Config.MouseRetargetClosest,
        UltraScanInterval = Config.UltraScanInterval,
        MinLockDistance = Config.MinLockDistance,
        MaxLockDistance = Config.MaxLockDistance,
        StrongValidation = Config.StrongValidation,
        InstantBehindSnap = Config.InstantBehindSnap,
        IgnoreActiveCounter = Config.IgnoreActiveCounter,
        TargetPriority = Config.TargetPriority,
        ToggleKey = keyToStr(Config.ToggleKey),
        EnableLockKey = keyToStr(Config.EnableLockKey),
        StickyLockKey = keyToStr(Config.StickyLockKey),
        BehindKey = keyToStr(Config.BehindKey),
        PriorityKey = keyToStr(Config.PriorityKey),
        HoldThreshold = Config.HoldThreshold,
        ClickLockDuration = Config.ClickLockDuration,
        MouseHoldThreshold = Config.MouseHoldThreshold,
        MouseClickLockDuration = Config.MouseClickLockDuration,
        UseMouseButton1 = Config.UseMouseButton1,
        LockKeys = lockKeyNames,
        IgnoreAlliesEnabled = Config.IgnoreAllies.Enabled,
        IgnoreAlliesUseUserId = Config.IgnoreAllies.UseUserId,
        IgnoreAlliesUserIds = Config.IgnoreAllies.UserIds,
        IgnoreAlliesNames = Config.IgnoreAllies.Names,
        Theme = CurrentThemeName,
    }
end

local function applyConfig(data)
    if not data or type(data) ~= "table" then return false end
    local function set(k, v)
        if v ~= nil then Config[k] = v end
    end
    set("RotateMode", data.RotateMode)
    set("TurnDeadzoneDegrees", data.TurnDeadzoneDegrees)
    set("ZeroDeadzoneWhenHolding", data.ZeroDeadzoneWhenHolding)
    set("UsePrediction", data.UsePrediction)
    set("PredictionStrength", data.PredictionStrength)
    set("PredictionMaxSpeed", data.PredictionMaxSpeed)
    set("PredictionHistorySmoothing", data.PredictionHistorySmoothing)
    if data.AimPointDefault then
        Config.AimPointBySource.default = data.AimPointDefault
        Config.AimPointBySource.sticky = data.AimPointDefault
        Config.AimPointBySource.priority = data.AimPointDefault
    end
    if data.AimOffsetDefault then
        Config.AimOffsetBySource.default = data.AimOffsetDefault
        Config.AimOffsetBySource.sticky = data.AimOffsetDefault
        Config.AimOffsetBySource.priority = data.AimOffsetDefault
    end
    set("AboveHeadHeight", data.AboveHeadHeight)
    set("AimSmooth", data.AimSmooth)
    set("UseSmoothTurn", data.UseSmoothTurn)
    set("Smoothness", data.Smoothness)
    set("BehindHoldDelay", data.BehindHoldDelay)
    set("BehindDistance", data.BehindDistance)
    set("BehindSmoothTime", data.BehindSmoothTime)
    set("EnableTeleport", data.EnableTeleport)
    set("BlockRetargetClosest", data.BlockRetargetClosest)
    set("SkillRetargetClosest", data.SkillRetargetClosest)
    set("MouseRetargetClosest", data.MouseRetargetClosest)
    set("UltraScanInterval", data.UltraScanInterval)
    set("MinLockDistance", data.MinLockDistance)
    set("MaxLockDistance", data.MaxLockDistance)
    set("StrongValidation", data.StrongValidation)
    set("InstantBehindSnap", data.InstantBehindSnap)
    set("IgnoreActiveCounter", data.IgnoreActiveCounter)
    set("TargetPriority", data.TargetPriority)
    if data.ToggleKey then Config.ToggleKey = strToKey(data.ToggleKey) end
    if data.EnableLockKey then Config.EnableLockKey = strToKey(data.EnableLockKey) end
    if data.StickyLockKey then Config.StickyLockKey = strToKey(data.StickyLockKey) end
    if data.BehindKey then Config.BehindKey = strToKey(data.BehindKey) end
    if data.PriorityKey then Config.PriorityKey = strToKey(data.PriorityKey) end
    set("HoldThreshold", data.HoldThreshold)
    set("ClickLockDuration", data.ClickLockDuration)
    set("MouseHoldThreshold", data.MouseHoldThreshold)
    set("MouseClickLockDuration", data.MouseClickLockDuration)
    set("UseMouseButton1", data.UseMouseButton1)
    if type(data.LockKeys) == "table" then
        Config.LockKeys = {}
        for _, name in ipairs(data.LockKeys) do
            local k = strToKey(name)
            if k ~= Enum.KeyCode.Unknown then table.insert(Config.LockKeys, k) end
        end
    end
    if data.IgnoreAlliesEnabled ~= nil then Config.IgnoreAllies.Enabled = data.IgnoreAlliesEnabled end
    if data.IgnoreAlliesUseUserId ~= nil then Config.IgnoreAllies.UseUserId = data.IgnoreAlliesUseUserId end
    if type(data.IgnoreAlliesUserIds) == "table" then Config.IgnoreAllies.UserIds = data.IgnoreAlliesUserIds end
    if type(data.IgnoreAlliesNames) == "table" then Config.IgnoreAllies.Names = data.IgnoreAlliesNames end
    rebuildAllyCache()
    if data.Theme and Themes[data.Theme] then
        CurrentThemeName = data.Theme
        Theme = Themes[data.Theme]
        TopLine.BackgroundColor3 = Theme.Accent
    end
    return true
end

local function canFS()
    return type(writefile) == "function" and type(readfile) == "function"
end

local function ensureFolder()
    if type(isfolder) == "function" and type(makefolder) == "function" then
        if not isfolder(SAVE_FOLDER) then
            pcall(makefolder, SAVE_FOLDER)
        end
    end
end

local function saveConfig(name)
    name = name or "default"
    local path = SAVE_FOLDER .. "/" .. name .. ".json"
    local ok, err = pcall(function()
        ensureFolder()
        local json = HttpService:JSONEncode(serializeConfig())
        if canFS() then
            writefile(path, json)
        else
            if type(setclipboard) == "function" then
                setclipboard(json)
            end
            error("No writefile — config copied to clipboard instead")
        end
    end)
    return ok, err
end

local function loadConfig(name)
    name = name or "default"
    local path = SAVE_FOLDER .. "/" .. name .. ".json"
    local ok, data = pcall(function()
        if canFS() and (type(isfile) ~= "function" or isfile(path)) then
            local raw = readfile(path)
            return HttpService:JSONDecode(raw)
        end
        error("File not found or no readfile")
    end)
    if ok and data then
        applyConfig(data)
        return true
    end
    return false, data
end

local cSave = Card(pageCF.left, "Save / Load")
local statusCfg = Label(cSave, "Status: ready", 11, Theme.SubText)
statusCfg.Size = UDim2.new(1, 0, 0, 20)

local nameBox = New("TextBox", {
    Size = UDim2.new(1, 0, 0, 28),
    BackgroundColor3 = Theme.Element,
    Text = "default",
    PlaceholderText = "config name",
    TextColor3 = Theme.Text,
    PlaceholderColor3 = Theme.SubText,
    TextSize = 12,
    Font = Enum.Font.Gotham,
    ClearTextOnFocus = false,
    BorderSizePixel = 0,
}, cSave)
Corner(nameBox, 5)

local function makeBtn(parent, text, color, fn)
    local b = New("TextButton", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = color or Theme.Accent,
        BorderSizePixel = 0,
        Text = text,
        TextColor3 = Color3.new(1,1,1),
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
    }, parent)
    Corner(b, 6)
    b.Activated:Connect(fn)
    return b
end

makeBtn(cSave, "Save Config", Theme.Accent, function()
    local name = nameBox.Text
    if name == "" then name = "default" end
    local ok, err = saveConfig(name)
    if ok then
        statusCfg.Text = "Status: saved → " .. name
        statusCfg.TextColor3 = Theme.Green
    else
        statusCfg.Text = "Status: " .. tostring(err)
        statusCfg.TextColor3 = Theme.Red
    end
end)

makeBtn(cSave, "Load Config", Theme.AccentDark, function()
    local name = nameBox.Text
    if name == "" then name = "default" end
    local ok, err = loadConfig(name)
    if ok then
        statusCfg.Text = "Status: loaded ← " .. name .. " (reopen menu if UI stale)"
        statusCfg.TextColor3 = Theme.Green
        rebuildPlayerList()
        for _, b in ipairs(AllBinds) do if b.Refresh then b.Refresh() end end
    else
        statusCfg.Text = "Status: load failed — " .. tostring(err)
        statusCfg.TextColor3 = Theme.Red
    end
end)

makeBtn(cSave, "Copy Config to Clipboard", Theme.Element, function()
    local ok, err = pcall(function()
        local json = HttpService:JSONEncode(serializeConfig())
        if type(setclipboard) == "function" then
            setclipboard(json)
        else
            error("setclipboard not available")
        end
    end)
    if ok then
        statusCfg.Text = "Status: copied to clipboard"
        statusCfg.TextColor3 = Theme.Green
    else
        statusCfg.Text = "Status: " .. tostring(err)
        statusCfg.TextColor3 = Theme.Red
    end
end)

