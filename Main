local cPl = Card(pageWL.right, "Players in Server")
local plScroll = New("ScrollingFrame", {
    Size = UDim2.new(1, 0, 0, 300),
    BackgroundTransparency = 1,
    BorderSizePixel = 0,
    ScrollBarThickness = 3,
    ScrollBarImageColor3 = Theme.Accent,
    CanvasSize = UDim2.new(0, 0, 0, 0),
    AutomaticCanvasSize = Enum.AutomaticSize.Y,
}, cPl)
New("UIListLayout", {Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.Name}, plScroll)

local function isWhitelisted(plr)
    if Config.IgnoreAllies.UseUserId then
        for _, id in ipairs(Config.IgnoreAllies.UserIds) do
            if tonumber(id) == plr.UserId then return true end
        end
    else
        local w = string.lower(plr.Name)
        for _, name in ipairs(Config.IgnoreAllies.Names) do
            if string.lower(tostring(name)) == w then return true end
        end
    end
    return false
end

local function setWhitelisted(plr, value)
    if Config.IgnoreAllies.UseUserId then
        local ids = Config.IgnoreAllies.UserIds
        for i = #ids, 1, -1 do
            if tonumber(ids[i]) == plr.UserId then table.remove(ids, i) end
        end
        if value then table.insert(ids, plr.UserId) end
    else
        local names = Config.IgnoreAllies.Names
        for i = #names, 1, -1 do
            if string.lower(tostring(names[i])) == string.lower(plr.Name) then table.remove(names, i) end
        end
        if value then table.insert(names, plr.Name) end
    end
    rebuildAllyCache()
end

local function rebuildPlayerList()
    for _, c in ipairs(plScroll:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local on = isWhitelisted(plr)
            local b = New("TextButton", {
                Size = UDim2.new(1, -4, 0, 28),
                BackgroundColor3 = on and Color3.fromRGB(40, 70, 50) or Theme.Element,
                BorderSizePixel = 0,
                Text = "  " .. plr.Name .. (on and "  ✓" or ""),
                TextColor3 = Theme.Text,
                TextSize = 12,
                Font = Enum.Font.GothamMedium,
                TextXAlignment = Enum.TextXAlignment.Left,
                AutoButtonColor = false,
            }, plScroll)
            Corner(b, 5)
            b.Activated:Connect(function()
                setWhitelisted(plr, not isWhitelisted(plr))
                local now = isWhitelisted(plr)
                b.BackgroundColor3 = now and Color3.fromRGB(40, 70, 50) or Theme.Element
                b.Text = "  " .. plr.Name .. (now and "  ✓" or "")
            end)
        end
    end
end
rebuildPlayerList()
Players.PlayerAdded:Connect(rebuildPlayerList)
Players.PlayerRemoving:Connect(rebuildPlayerList)

local clearBtn = New("TextButton", {
    Size = UDim2.new(1, 0, 0, 28),
    BackgroundColor3 = Theme.Element,
    BorderSizePixel = 0,
    Text = "Clear Whitelist",
    TextColor3 = Theme.Text,
    TextSize = 12,
    Font = Enum.Font.GothamMedium,
    AutoButtonColor = false,
}, cPl)
Corner(clearBtn, 5)
clearBtn.Activated:Connect(function()
    table.clear(Config.IgnoreAllies.UserIds)
    table.clear(Config.IgnoreAllies.Names)
    rebuildAllyCache()
    rebuildPlayerList()
end)

