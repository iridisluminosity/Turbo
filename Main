    Size = UDim2.new(1, -16, 1, -20),
    Position = UDim2.fromOffset(8, 12),
    BackgroundTransparency = 1,
}, Sidebar)
New("UIListLayout", {Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder}, TabContainer)

local Content = New("Frame", {
    Size = UDim2.new(1, -140, 1, -48),
    Position = UDim2.fromOffset(140, 48),
    BackgroundTransparency = 1,
    ClipsDescendants = false,
}, Main)

local Pages = {}
local TabButtons = {}

local function CreatePage(name)
    local page = New("ScrollingFrame", {
        Name = name,
        Size = UDim2.new(1, -16, 1, -16),
        Position = UDim2.fromOffset(8, 8),
        BackgroundTransparency = 1,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        BorderSizePixel = 0,
        ClipsDescendants = false,
        ScrollingDirection = Enum.ScrollingDirection.Y,
    }, Content)
    -- two columns via grid
    New("UIGridLayout", {
        CellPadding = UDim2.fromOffset(10, 10),
        CellSize = UDim2.new(0.5, -5, 0, 0),
        FillDirectionMaxCells = 2,
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, page)
    -- fix: use list of cards with automatic size instead of fixed grid height
    page:FindFirstChildOfClass("UIGridLayout"):Destroy()
    local row = New("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        ClipsDescendants = false,
    }, page)
    local left = New("Frame", {
        Name = "L",
        Size = UDim2.new(0.5, -5, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        ClipsDescendants = false,
    }, row)
    New("UIListLayout", {Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder}, left)
    local right = New("Frame", {
        Name = "R",
        Size = UDim2.new(0.5, -5, 0, 0),
        Position = UDim2.new(0.5, 5, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        ClipsDescendants = false,
    }, row)
    New("UIListLayout", {Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder}, right)
    Pages[name] = {page = page, left = left, right = right}
    return Pages[name]
end

local function SelectTab(name)
    for n, p in pairs(Pages) do
        p.page.Visible = (n == name)
    end
    for n, btn in pairs(TabButtons) do
        local on = (n == name)
        btn.BackgroundTransparency = on and 0 or 1
        btn.BackgroundColor3 = Theme.Element
        local ind = btn:FindFirstChild("Indicator")
        if ind then ind.Visible = on end
        for _, c in ipairs(btn:GetChildren()) do
            if c:IsA("TextLabel") then
                if c.Name == "Icon" then
                    c.TextColor3 = on and Theme.Accent or Theme.SubText
                else
                    c.TextColor3 = on and Theme.Text or Theme.SubText
                end
            end
        end
    end
end

local function CreateTab(name, icon, order)
    local btn = New("TextButton", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = Theme.Element,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        LayoutOrder = order,
        Active = true,
    }, TabContainer)
    Corner(btn, 6)
    local ind = New("Frame", {
        Name = "Indicator",
        Size = UDim2.fromOffset(3, 18),
        Position = UDim2.new(0, 0, 0.5, -9),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Visible = false,
    }, btn)
    Corner(ind, 2)
    local ic = Label(btn, icon, 14, Theme.SubText, true)
    ic.Name = "Icon"
    ic.Size = UDim2.fromOffset(24, 36)
    ic.Position = UDim2.fromOffset(8, 0)
    ic.TextXAlignment = Enum.TextXAlignment.Center
    local tx = Label(btn, name, 12, Theme.SubText, true)
    tx.Position = UDim2.fromOffset(34, 0)
    tx.Size = UDim2.new(1, -40, 1, 0)
    btn.Activated:Connect(function()
        SelectTab(name)
    end)
    TabButtons[name] = btn
end

