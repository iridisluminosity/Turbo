pageTitle.Position = UDim2.fromOffset(18, 12)
pageTitle.Size = UDim2.fromOffset(400, 26)

local pageSub = label(content, "Targeting, rotation, prediction and lock behaviour.", 11, TurboTheme.SubText)
pageSub.Position = UDim2.fromOffset(18, 36)
pageSub.Size = UDim2.fromOffset(600, 18)

local pages = {}
local tabButtons = {}
local currentPage

local function makePage(name)
    local p = new("ScrollingFrame", {
        Name = name,
        Position = UDim2.fromOffset(12, 62),
        Size = UDim2.new(1, -24, 1, -74),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = TurboTheme.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
    }, content)
    padding(p, 2, 6, 2, 8)
    new("UIListLayout", {
        Padding = UDim.new(0, 7),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, p)
    pages[name] = p
    return p
end

local pageLock = makePage("CharacterLock")
local pageRotate = makePage("Rotate Method")
local pageAim = makePage("Aim Parts")
local pageWhite = makePage("Whitelist")
local pageSettings = makePage("Settings")

local function selectPage(name)
    currentPage = name
    for n, p in pairs(pages) do
        p.Visible = n == name
    end
    for n, b in pairs(tabButtons) do
        local isActive = n == name
        b.BackgroundColor3 = isActive and TurboTheme.Accent or TurboTheme.Panel2
        b.TextColor3 = isActive and Color3.new(1, 1, 1) or TurboTheme.SubText
    end
    pageTitle.Text = name
    if name == "CharacterLock" then
        pageSub.Text = "Targeting, prediction, aim and validation."
    elseif name == "Rotate Method" then
        pageSub.Text = "Rotation method and all its tuning parameters."
    elseif name == "Aim Parts" then
        pageSub.Text = "Custom aim part and offset per lock source (Block, Skill, M1)."
    elseif name == "Whitelist" then
        pageSub.Text = "Ignore selected players when locking targets."
    else
        pageSub.Text = "Hotkeys, timing, priorities and menu appearance."
    end
end

local function makeTab(name, icon, order)
    local b = new("TextButton", {
        Name = name,
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = TurboTheme.Panel2,
        BorderSizePixel = 0,
        Text = "  " .. icon .. "   " .. name,
        TextColor3 = TurboTheme.SubText,
        TextSize = 13,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = order,
        AutoButtonColor = false,
    }, tabs)
    corner(b, 8)
    turboConnect(b.MouseButton1Click, function()
        selectPage(name)
    end)
    tabButtons[name] = b
end

makeTab("CharacterLock", "◆", 1)
makeTab("Rotate Method", "↻", 2)
makeTab("Aim Parts", "◈", 3)
makeTab("Whitelist", "◇", 4)
makeTab("Settings", "⚙", 5)

local function section(parent, name, desc)
    local f = new("Frame", {
        Size = UDim2.new(1, -4, 0, 40),
        BackgroundColor3 = TurboTheme.Panel3,
        BorderSizePixel = 0,
        LayoutOrder = 0,
    }, parent)
    corner(f, 8)
    local t = label(f, name, 12, TurboTheme.Accent2, true)
    t.Position = UDim2.fromOffset(12, 2)
    t.Size = UDim2.new(1, -24, 0, 18)
    local d = label(f, desc or "", 10, TurboTheme.SubText)
    d.Position = UDim2.fromOffset(12, 20)
    d.Size = UDim2.new(1, -24, 0, 16)
    return f
end

local function toggle(parent, text, getter, setter)
    local row = new("Frame", {
        Size = UDim2.new(1, -4, 0, 40),
        BackgroundColor3 = TurboTheme.Panel2,
        BorderSizePixel = 0,
    }, parent)
    corner(row, 8)

    local t = label(row, text, 12)
    t.Position = UDim2.fromOffset(12, 0)
    t.Size = UDim2.new(1, -90, 1, 0)

    local b = new("TextButton", {
        Size = UDim2.fromOffset(58, 24),
        Position = UDim2.new(1, -70, 0.5, -12),
        BackgroundColor3 = TurboTheme.Red,
        BorderSizePixel = 0,
        Text = "OFF",
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 10,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
    }, row)
    corner(b, 6)

    local function refresh()
        local on = getter()
        b.Text = on and "ON" or "OFF"
        b.BackgroundColor3 = on and TurboTheme.Green or TurboTheme.Red
    end
    refresh()

    turboConnect(b.MouseButton1Click, function()
        setter(not getter())
        refresh()
    end)
    return row, refresh
end

local function numberBox(parent, text, getter, setter, min, max, decimals)
    -- min/max/decimals are now IGNORED on purpose: users can freely type
    -- any number, including decimals like 1.4, 5.4, negative values, etc.
    -- Parameters kept for call-site compatibility but no longer clamp/round.
    local row = new("Frame", {
        Size = UDim2.new(1, -4, 0, 42),
        BackgroundColor3 = TurboTheme.Panel2,
        BorderSizePixel = 0,
    }, parent)
    corner(row, 8)

    local t = label(row, text, 12)
    t.Position = UDim2.fromOffset(12, 0)
    t.Size = UDim2.new(0.55, 0, 1, 0)

    local box = new("TextBox", {
        Size = UDim2.fromOffset(120, 26),
        Position = UDim2.new(1, -132, 0.5, -13),
        BackgroundColor3 = TurboTheme.Background,
        BorderSizePixel = 0,
        Text = tostring(getter()),
        TextColor3 = TurboTheme.Text,
        PlaceholderColor3 = TurboTheme.SubText,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        ClearTextOnFocus = false,
        TextXAlignment = Enum.TextXAlignment.Center,
    }, row)
    corner(box, 6)
    stroke(box, TurboTheme.Stroke, 1)

    turboConnect(box.FocusLost, function()
        local v = tonumber(box.Text)
        if v then
            setter(v)
        end
        box.Text = tostring(getter())
    end)
    return row
end

local allDropdownLists = {}

local function dropdown(parent, text, getter, setter, options)
    local row = new("Frame", {
        Size = UDim2.new(1, -4, 0, 42),
        BackgroundColor3 = TurboTheme.Panel2,
        BorderSizePixel = 0,
        ZIndex = 5,
    }, parent)
    corner(row, 8)

    local t = label(row, text, 12)
    t.Position = UDim2.fromOffset(12, 0)
    t.Size = UDim2.new(0.4, 0, 1, 0)

    local b = new("TextButton", {
        Size = UDim2.fromOffset(200, 26),
        Position = UDim2.new(1, -212, 0.5, -13),
        BackgroundColor3 = TurboTheme.Background,
        BorderSizePixel = 0,
        Text = tostring(getter()),
        TextColor3 = TurboTheme.Text,
        TextSize = 11,
        Font = Enum.Font.Gotham,
        AutoButtonColor = false,
        ZIndex = 10,
    }, row)
    corner(b, 6)
    stroke(b, TurboTheme.Stroke, 1)

    -- Lista é um Frame simples (sem ScrollingFrame) para garantir que TODOS os itens,
    -- incluindo os últimos, sejam sempre clicáveis. Nenhuma das listas usadas neste menu
    -- é longa o suficiente para realmente precisar de scroll (máx. ~12 itens = 336px),
    -- então evitamos qualquer interferência de ScrollBar/Canvas com os cliques.
    local listHeightTotal = #options * 28
    local list = new("Frame", {
        Name = "DropdownOverlay",
        Visible = false,
        Size = UDim2.fromOffset(200, listHeightTotal),
        BackgroundColor3 = TurboTheme.Background,
        BorderSizePixel = 0,
        ZIndex = 500,
        ClipsDescendants = false,
    }, screen)
    corner(list, 6)
    stroke(list, TurboTheme.Stroke, 1)
    new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, list)
    table.insert(allDropdownLists, list)

    local function repositionList()
        local absPos = b.AbsolutePosition
        local absSize = b.AbsoluteSize
        local listHeight = listHeightTotal
        list.Size = UDim2.fromOffset(absSize.X, listHeight)
        local screenHeight = (camera and camera.ViewportSize.Y) or 720
        local y = absPos.Y + absSize.Y + 4
        if y + listHeight > screenHeight then
            y = absPos.Y - listHeight - 4
        end
        y = math.clamp(y, 0, math.max(0, screenHeight - listHeight))
        list.Position = UDim2.fromOffset(absPos.X, y)
    end

    for i, option in ipairs(options) do
        local opt = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 28),
            BackgroundTransparency = 1,
            Text = tostring(option),
            TextColor3 = TurboTheme.Text,
            TextSize = 11,
            Font = Enum.Font.Gotham,
            AutoButtonColor = false,
            ZIndex = 501,
            LayoutOrder = i,
        }, list)
        turboConnect(opt.MouseButton1Click, function()
            setter(option)
            b.Text = tostring(getter())
            list.Visible = false
        end)
        turboConnect(opt.MouseEnter, function()
            opt.BackgroundTransparency = 0.85
            opt.BackgroundColor3 = TurboTheme.Accent
        end)
        turboConnect(opt.MouseLeave, function()
            opt.BackgroundTransparency = 1
        end)
    end

    turboConnect(b.MouseButton1Click, function()
        if not list.Visible then
            repositionList()
        end
        list.Visible = not list.Visible
    end)

    -- Fecha o dropdown se clicar fora dele. Usa InputEnded (não InputBegan) para que o
    -- clique em uma opção seja processado e resolvido ANTES de decidirmos se devemos
    -- fechar a lista, garantindo que todos os itens (inclusive os últimos) respondam ao clique.
    turboConnect(UserInputService.InputEnded, function(input)
        if not list.Visible then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local mousePos = UserInputService:GetMouseLocation()
        local lp, ls = list.AbsolutePosition, list.AbsoluteSize
        local bp, bs = b.AbsolutePosition, b.AbsoluteSize
        local overList = mousePos.X >= lp.X and mousePos.X <= lp.X + ls.X and mousePos.Y >= lp.Y and mousePos.Y <= lp.Y + ls.Y
        local overButton = mousePos.X >= bp.X and mousePos.X <= bp.X + bs.X and mousePos.Y >= bp.Y and mousePos.Y <= bp.Y + bs.Y
        if not overList and not overButton then
            list.Visible = false
        end
    end)

    return row
end

local function keybind(parent, text, getter, setter)
    local row = new("Frame", {
        Size = UDim2.new(1, -4, 0, 42),
        BackgroundColor3 = TurboTheme.Panel2,
        BorderSizePixel = 0,
    }, parent)
    corner(row, 8)

    local t = label(row, text, 12)
    t.Position = UDim2.fromOffset(12, 0)
    t.Size = UDim2.new(0.5, 0, 1, 0)

    local b = new("TextButton", {
        Size = UDim2.fromOffset(120, 26),
        Position = UDim2.new(1, -132, 0.5, -13),
        BackgroundColor3 = TurboTheme.Background,
        BorderSizePixel = 0,
        Text = getter().Name,
        TextColor3 = TurboTheme.Text,
        TextSize = 11,
        Font = Enum.Font.Gotham,
        AutoButtonColor = false,
    }, row)
    corner(b, 6)
    stroke(b, TurboTheme.Stroke, 1)

    local listening = false
    turboConnect(b.MouseButton1Click, function()
        listening = true
        b.Text = "..."
        b.TextColor3 = TurboTheme.Accent
    end)

    turboConnect(UserInputService.InputBegan, function(input)
        if listening and input.UserInputType == Enum.UserInputType.Keyboard then
            listening = false
            setter(input.KeyCode)
            b.Text = input.KeyCode.Name
            b.TextColor3 = TurboTheme.Text
        end
    end)
    return row
end

