local commonKeys = {
    {Enum.KeyCode.One, "1"}, {Enum.KeyCode.Two, "2"}, {Enum.KeyCode.Three, "3"},
    {Enum.KeyCode.Four, "4"}, {Enum.KeyCode.F, "F"}, {Enum.KeyCode.E, "E"},
    {Enum.KeyCode.R, "R"}, {Enum.KeyCode.G, "G"},
}
local function isKeyIn(key)
    for _, k in ipairs(Config.LockKeys) do if k == key then return true end end
    return false
end
local function toggleKey(key)
    for i, k in ipairs(Config.LockKeys) do
        if k == key then table.remove(Config.LockKeys, i) return end
    end
    table.insert(Config.LockKeys, key)
end
for i, e in ipairs(commonKeys) do
    local key, name = e[1], e[2]
    local btn = New("TextButton", {
        Size = UDim2.fromOffset(34, 26),
        BackgroundColor3 = isKeyIn(key) and Theme.Accent or Theme.Element,
        BorderSizePixel = 0,
        Text = name,
        TextColor3 = Theme.Text,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
        LayoutOrder = i,
    }, keyRow)
    Corner(btn, 5)
    btn.Activated:Connect(function()
        toggleKey(key)
        btn.BackgroundColor3 = isKeyIn(key) and Theme.Accent or Theme.Element
    end)
end

