plTitle.Size = UDim2.new(1, -24, 0, 22)

local plScroll = new("ScrollingFrame", {
    Position = UDim2.fromOffset(8, 34),
    Size = UDim2.new(1, -16, 1, -42),
    BackgroundTransparency = 1,
    BorderSizePixel = 0,
    ScrollBarThickness = 3,
    ScrollBarImageColor3 = TurboTheme.Accent,
    CanvasSize = UDim2.new(0, 0, 0, 0),
    AutomaticCanvasSize = Enum.AutomaticSize.Y,
}, playerList)
new("UIListLayout", {
    Padding = UDim.new(0, 4),
    SortOrder = Enum.SortOrder.Name,
}, plScroll)

local function isWhitelisted(plr)
    if Config.IgnoreAllies.UseUserId then
        for _, id in ipairs(Config.IgnoreAllies.UserIds) do
            if tonumber(id) == plr.UserId then return true end
        end
    else
        local wanted = string.lower(plr.Name)
        for _, name in ipairs(Config.IgnoreAllies.Names) do
            if string.lower(tostring(name)) == wanted then return true end
        end
    end
    return false
end

local function setWhitelisted(plr, value)
    if Config.IgnoreAllies.UseUserId then
        local ids = Config.IgnoreAllies.UserIds
        for i = #ids, 1, -1 do
            if tonumber(ids[i]) == plr.UserId then table.remove(ids, i) end
        end
        if value then table.insert(ids, plr.UserId) end
    else
        local names = Config.IgnoreAllies.Names
        for i = #names, 1, -1 do
            if string.lower(tostring(names[i])) == string.lower(plr.Name) then
                table.remove(names, i)
            end
        end
        if value then table.insert(names, plr.Name) end
    end
    rebuildAllyCache()
end

local function rebuildPlayerList()
    for _, child in ipairs(plScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local on = isWhitelisted(plr)
            local b = new("TextButton", {
                Size = UDim2.new(1, -4, 0, 32),
                BackgroundColor3 = on and Color3.fromRGB(40, 90, 60) or TurboTheme.Background,
                BorderSizePixel = 0,
                Text = "  " .. plr.Name .. (on and "  ✓" or ""),
                TextColor3 = TurboTheme.Text,
                TextSize = 12,
                Font = Enum.Font.GothamMedium,
                TextXAlignment = Enum.TextXAlignment.Left,
                AutoButtonColor = false,
            }, plScroll)
            corner(b, 6)
            turboConnect(b.MouseButton1Click, function()
                setWhitelisted(plr, not isWhitelisted(plr))
                local now = isWhitelisted(plr)
                b.BackgroundColor3 = now and Color3.fromRGB(40, 90, 60) or TurboTheme.Background
                b.Text = "  " .. plr.Name .. (now and "  ✓" or "")
            end)
        end
    end
end

rebuildPlayerList()
turboConnect(Players.PlayerAdded, rebuildPlayerList)
turboConnect(Players.PlayerRemoving, rebuildPlayerList)

local clearWhite = new("TextButton", {
    Size = UDim2.new(1, -4, 0, 36),
    BackgroundColor3 = TurboTheme.Panel2,
    BorderSizePixel = 0,
    Text = "Clear Whitelist",
    TextColor3 = TurboTheme.Text,
    TextSize = 12,
    Font = Enum.Font.GothamMedium,
    AutoButtonColor = false,
}, pageWhite)
corner(clearWhite, 8)
turboConnect(clearWhite.MouseButton1Click, function()
    table.clear(Config.IgnoreAllies.UserIds)
    table.clear(Config.IgnoreAllies.Names)
    rebuildAllyCache()
    rebuildPlayerList()
end)

