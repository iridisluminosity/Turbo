local qHoldStart, lastBehindTime = 0, 0
local isTeleporting = false
local isHoldingMouse, mousePressTime = false, 0
local grabConnections = {}
local allyUserIdSet, allyNameSet = {}, {}
local smoothedAimPos, smoothedAimTarget = nil, nil
local targetHistory = {}
local lastRetarget = 0
local alignAttachment, alignOrientation = nil, nil
local align2Attachment, align2Orientation = nil, nil
local align2TargetAttachment = nil
local bodyGyro = nil
local angVelConstraint, angVelAttachment = nil, nil
local torqueConstraint, torqueAttachment = nil, nil
