-- ===================== AIM PARTS PAGE =====================
local AIM_PART_OPTIONS = {"Root", "Head", "AboveHead", "Torso", "Chest", "Body", "Front", "Back", "Left", "Right", "LeftArm", "RightArm"}

-- Block uses whichever key is flagged as the "block" key (F by default, but
-- kept generic here so it can be rebound like any other key).
local function isBlockKeyBound(key)
    return key == Config.BlockKey
end

if Config.BlockKey == nil then
    Config.BlockKey = Enum.KeyCode.F
end

local function aimSourceSection(sourceKey, displayName, desc, keyGetter, keySetter)
    section(pageAim, displayName, desc)
    if keyGetter and keySetter then
        keybind(pageAim, displayName .. " Key",
            keyGetter, keySetter)
    end
    dropdown(pageAim, displayName .. " Aim Part",
        function() return Config.AimPointBySource[sourceKey] end,
        function(v) Config.AimPointBySource[sourceKey] = v end,
        AIM_PART_OPTIONS
    )
    numberBox(pageAim, displayName .. " Offset",
        function() return Config.AimOffsetBySource[sourceKey] end,
        function(v) Config.AimOffsetBySource[sourceKey] = v end)
end

aimSourceSection("block", "Block", "Aim part, offset and key used for Block.",
    function() return Config.BlockKey end,
    function(v) Config.BlockKey = v end)
aimSourceSection("skill", "Skill", "Aim part and offset used for Skill lock keys (customize keys in Settings > Lock Keys).")
aimSourceSection("mouse", "M1", "Aim part and offset used while holding Mouse Button 1.")
aimSourceSection("q", "Behind", "Aim part, offset and key used for the Behind lock.",
    function() return Config.BehindKey end,
    function(v) Config.BehindKey = v end)
section(pageAim, "Priority / Sticky", "Aim part, offset and keys used for Priority and Sticky lock.")
keybind(pageAim, "Priority Key",
    function() return Config.PriorityKey end,
    function(v) Config.PriorityKey = v end)
keybind(pageAim, "Sticky Key",
    function() return Config.StickyLockKey end,
    function(v) Config.StickyLockKey = v end)
dropdown(pageAim, "Priority / Sticky Aim Part",
    function() return Config.AimPointBySource.priority end,
    function(v)
        Config.AimPointBySource.priority = v
        Config.AimPointBySource.sticky = v
    end,
    AIM_PART_OPTIONS
)
numberBox(pageAim, "Priority / Sticky Offset",
    function() return Config.AimOffsetBySource.priority end,
    function(v)
        Config.AimOffsetBySource.priority = v
        Config.AimOffsetBySource.sticky = v
    end)

