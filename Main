    if lockEnabled then
        status.Text = "ACTIVE"
        status.TextColor3 = TurboTheme.Green
        statusDot.BackgroundColor3 = TurboTheme.Green
    else
        status.Text = "OFF"
        status.TextColor3 = TurboTheme.Red
        statusDot.BackgroundColor3 = TurboTheme.Red
    end
end)

