section(pageLock, "MASTER", "Enable or disable the entire lock system.")
local masterToggle, masterToggleRefresh
masterToggle, masterToggleRefresh = toggle(pageLock, "ENABLE LOCK",
    function() return lockEnabled end,
    function(v)
        setLockEnabled(v)
    end)

onLockEnabledChanged = function(v)
    if masterToggleRefresh then masterToggleRefresh() end
    if status then
        status.Text = v and "ACTIVE" or "OFF"
        status.TextColor3 = v and TurboTheme.Green or TurboTheme.Red
        statusDot.BackgroundColor3 = v and TurboTheme.Green or TurboTheme.Red
    end
end

