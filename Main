local saveConfigBtn = new("TextButton", {
    Size = UDim2.fromOffset(120, 26),
    Position = UDim2.new(1, -132, 0.5, -13),
    BackgroundColor3 = TurboTheme.Background,
    BorderSizePixel = 0,
    Text = "Save",
    TextColor3 = TurboTheme.Text,
    TextSize = 11,
    Font = Enum.Font.GothamBold,
    AutoButtonColor = false,
}, saveConfigRow)
corner(saveConfigBtn, 6)
stroke(saveConfigBtn, TurboTheme.Stroke, 1)

local function serializeValue(v)
    if typeof(v) == "EnumItem" then
        return v.Name
    elseif typeof(v) == "Vector3" then
        return {v.X, v.Y, v.Z}
    elseif type(v) == "table" then
        local out = {}
        for k2, v2 in pairs(v) do
            out[k2] = serializeValue(v2)
        end
        return out
    else
        return v
    end
end

local function getFileWriter()
    -- Different executors expose the file-write function under different names.
    -- Potassium / most Roblox exploit executors expose "writefile" globally.
    if writefile then return writefile end
    if _G.writefile then return _G.writefile end
    if syn and syn.write_file then return syn.write_file end
    if fluxus and fluxus.writefile then return fluxus.writefile end
    if getfenv and getfenv().writefile then return getfenv().writefile end
    return nil
end

local function saveConfigToFile()
    local data = {}
    local ok1, err1 = pcall(function()
        for k, v in pairs(Config) do
            data[k] = serializeValue(v)
        end
    end)
    if not ok1 then
        return false, "serialize error: " .. tostring(err1)
    end

    local ok2, jsonOrErr = pcall(function()
        local HttpService = game:GetService("HttpService")
        return HttpService:JSONEncode(data)
    end)
    if not ok2 then
        return false, "json encode error: " .. tostring(jsonOrErr)
    end

    local writer = getFileWriter()
    if not writer then
        return false, "writefile not found in this executor (Potassium should expose 'writefile')"
    end

    local ok3, err3 = pcall(function()
        writer("TurboLockConfig.json", jsonOrErr)
    end)
    if not ok3 then
        return false, "writefile error: " .. tostring(err3)
    end

    return true
end

turboConnect(saveConfigBtn.MouseButton1Click, function()
    local ok, err = saveConfigToFile()
    if ok then
        saveConfigBtn.Text = "Saved!"
        saveConfigBtn.TextColor3 = TurboTheme.Green
        print("[Turbo] Config salvo em TurboLockConfig.json")
    else
        saveConfigBtn.Text = "Erro!"
        saveConfigBtn.TextColor3 = TurboTheme.Red
        warn("[Turbo] Falha ao salvar config: " .. tostring(err))
    end
    task.delay(1.5, function()
        saveConfigBtn.Text = "Save"
        saveConfigBtn.TextColor3 = TurboTheme.Text
    end)
end)

local footer = label(main, "Turbo  ·  " .. Config.ToggleKey.Name .. " to toggle  ·  All controls write directly to Config", 10, TurboTheme.SubText)
footer.Position = UDim2.fromOffset(210, 556)
footer.Size = UDim2.fromOffset(640, 16)

do
    local dragging = false
    local dragStart, startPos

    turboConnect(top.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
        end
    end)

    turboConnect(UserInputService.InputChanged, function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    turboConnect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
end

local function setMenuVisible(v)
    main.Visible = v
    if not v then
        for _, list in ipairs(allDropdownLists) do
            list.Visible = false
        end
    end
end

turboConnect(UserInputService.InputBegan, function(input, processed)
    if processed then return end
    if input.KeyCode == Config.ToggleKey then
        setMenuVisible(not main.Visible)
    end
end)

