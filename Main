local TurboConnections = {}

local function turboDisconnectAll()
    for _, c in ipairs(TurboConnections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(TurboConnections)
end

local function turboConnect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(TurboConnections, c)
    return c
end

local TurboTheme = {
    Background = Color3.fromRGB(14, 14, 22),
    Panel      = Color3.fromRGB(20, 22, 34),
    Panel2     = Color3.fromRGB(26, 28, 44),
    Panel3     = Color3.fromRGB(32, 34, 52),
    Stroke     = Color3.fromRGB(58, 62, 88),
    Text       = Color3.fromRGB(242, 244, 252),
    SubText    = Color3.fromRGB(148, 154, 178),
    Accent     = Color3.fromRGB(138, 92, 255),
    Accent2    = Color3.fromRGB(168, 132, 255),
    Green      = Color3.fromRGB(72, 210, 130),
    Red        = Color3.fromRGB(235, 85, 100),
    Orange     = Color3.fromRGB(255, 160, 70),
    Blue       = Color3.fromRGB(70, 150, 255),
}

local function new(className, props, parent)
    local obj = Instance.new(className)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    if parent then obj.Parent = parent end
    return obj
end

local function corner(parent, radius)
    return new("UICorner", {CornerRadius = UDim.new(0, radius or 8)}, parent)
end

local function stroke(parent, color, thickness)
    return new("UIStroke", {
        Color = color or TurboTheme.Stroke,
        Thickness = thickness or 1,
        Transparency = 0,
    }, parent)
end

local function padding(parent, l, r, t, b)
    return new("UIPadding", {
        PaddingLeft   = UDim.new(0, l or 0),
        PaddingRight  = UDim.new(0, r or l or 0),
        PaddingTop    = UDim.new(0, t or l or 0),
        PaddingBottom = UDim.new(0, b or t or l or 0),
    }, parent)
end

local function label(parent, text, size, color, bold)
    return new("TextLabel", {
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = color or TurboTheme.Text,
        TextSize = size or 13,
        Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, parent)
end

