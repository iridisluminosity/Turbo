    "RootAnchor", "GrabIFrame", "GrabAnchor", "Grabbed",
    "IsGrabbed", "BeingGrabbed", "GrabVictim",
    "VictimAnchor", "GrabSlot", "InGrab", "GrabbedBy",
    "Carry", "Carried", "IsCarried", "HoldVictim", "Held",
}

local IGNORE_FOLDERS = {
    Effects = true, Bullets = true, Beams = true, Debris = true,
    FX = true, VFX = true, Particles = true, Projectiles = true,
    Logic = true, LogicData = true, Spawns = true, Items = true,
    Domains = true, Map = true, Terrain = true, Camera = true,
}

-- ======================================================
-- HELPERS
-- ======================================================
local function rebuildAllyCache()
    table.clear(allyUserIdSet)
    table.clear(allyNameSet)
    if not Config.IgnoreAllies.Enabled then return end
    if Config.IgnoreAllies.UseUserId then
        for _, id in ipairs(Config.IgnoreAllies.UserIds) do
            allyUserIdSet[tonumber(id)] = true
        end
    else
        for _, name in ipairs(Config.IgnoreAllies.Names) do
            allyNameSet[string.lower(tostring(name))] = true
        end
    end
end

rebuildAllyCache()

local function restoreMotor6D()
    if motor6D and motor6D.Parent and motor6DOriginalTransform then
        pcall(function()
            motor6D.Transform = motor6DOriginalTransform
        end)
    end
end

local function destroyRotateInstances()
    restoreMotor6D()
    local objects = {
        alignOrientation, alignAttachment,
        align2Orientation, align2Attachment, align2TargetAttachment,
        bodyGyro, angVelConstraint, angVelAttachment,
        torqueConstraint, torqueAttachment,
    }
    for _, obj in ipairs(objects) do
        if obj then
            pcall(function() obj:Destroy() end)
        end
    end
    alignOrientation, alignAttachment = nil, nil
    align2Orientation, align2Attachment, align2TargetAttachment = nil, nil, nil
    bodyGyro = nil
    angVelConstraint, angVelAttachment = nil, nil
    torqueConstraint, torqueAttachment = nil, nil
    motor6D, motor6DOriginalTransform = nil, nil
end

local function findRootMotor6D()
    if not character then return nil end
    local joint = character:FindFirstChild("RootJoint", true)
        or character:FindFirstChild("Root", true)
    if joint and joint:IsA("Motor6D") then
        return joint
    end
    return nil
end

local function getRoot(model)
    if not model then return nil end
    local hrp = model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("RootPart")
        or model:FindFirstChild("Root")
        or model.PrimaryPart
    if hrp and hrp:IsA("BasePart") then return hrp end
    return nil
end

local function setupRotateInstances(target)
    destroyRotateInstances()
    if not rootPart then return end
    local mode = Config.RotateMode
    if mode == "Align" then
        alignAttachment = Instance.new("Attachment")
        alignAttachment.Name = "LockAlignAtt"
        alignAttachment.Parent = rootPart
        alignOrientation = Instance.new("AlignOrientation")
        alignOrientation.Name = "LockAlign"
        alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
        alignOrientation.Attachment0 = alignAttachment
        alignOrientation.Responsiveness = Config.AlignResponsiveness or 4000
        alignOrientation.MaxTorque = Config.AlignMaxTorque or 1e9
        alignOrientation.MaxAngularVelocity = math.huge
        alignOrientation.RigidityEnabled = Config.AlignRigidity == true
        alignOrientation.Enabled = false
        alignOrientation.Parent = rootPart
    elseif mode == "Align2" then
        if not target then return end
        local targetRoot = getRoot(target)
        if not targetRoot then return end
        align2Attachment = Instance.new("Attachment")
        align2Attachment.Name = "LockAlign2Att"
        align2Attachment.Parent = rootPart
        align2TargetAttachment = Instance.new("Attachment")
        align2TargetAttachment.Name = "LockAlign2Target"
        align2TargetAttachment.Parent = targetRoot
        align2Orientation = Instance.new("AlignOrientation")
        align2Orientation.Name = "LockAlign2"
        align2Orientation.Mode = Enum.OrientationAlignmentMode.TwoAttachment
        align2Orientation.Attachment0 = align2Attachment
        align2Orientation.Attachment1 = align2TargetAttachment
        align2Orientation.MaxTorque = Config.AlignMaxTorque or 1e9
        align2Orientation.MaxAngularVelocity = math.huge
        align2Orientation.Responsiveness = Config.AlignResponsiveness or 4000
        align2Orientation.RigidityEnabled = Config.AlignRigidity == true
        align2Orientation.ReactionTorqueEnabled = false
        align2Orientation.Enabled = false
        align2Orientation.Parent = rootPart
    elseif mode == "BodyGyro" then
        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.Name = "LockGyro"
        bodyGyro.P = Config.GyroP or 35000
        bodyGyro.D = Config.GyroD or 400
        bodyGyro.MaxTorque = Vector3.zero
        bodyGyro.Parent = rootPart
    elseif mode == "AngularVel" then
        angVelAttachment = Instance.new("Attachment")
        angVelAttachment.Name = "LockAngVelAtt"
        angVelAttachment.Parent = rootPart
        angVelConstraint = Instance.new("AngularVelocity")
        angVelConstraint.Name = "LockAngVel"
        angVelConstraint.Attachment0 = angVelAttachment
        angVelConstraint.RelativeTo = Enum.ActuatorRelativeTo.World
        angVelConstraint.MaxTorque = Config.AngVelMaxTorque or 1e9
        angVelConstraint.AngularVelocity = Vector3.zero
        angVelConstraint.Enabled = false
        angVelConstraint.Parent = rootPart
    elseif mode == "Torque" then
        torqueAttachment = Instance.new("Attachment")
        torqueAttachment.Name = "LockTorqueAtt"
        torqueAttachment.Parent = rootPart
        torqueConstraint = Instance.new("Torque")
        torqueConstraint.Name = "LockTorque"
        torqueConstraint.Attachment0 = torqueAttachment
        torqueConstraint.RelativeTo = Enum.ActuatorRelativeTo.World
        torqueConstraint.Torque = Vector3.zero
        torqueConstraint.Enabled = false
        torqueConstraint.Parent = rootPart
    elseif mode == "Motor6D" then
        motor6D = findRootMotor6D()
        if motor6D then
            motor6DOriginalTransform = motor6D.Transform
        end
    end
end

local function yawError(flatLook, flatTo)
    local cross = flatLook:Cross(flatTo)
    local dot = math.clamp(flatLook:Dot(flatTo), -1, 1)
    return math.atan2(cross.Y, dot)
end

local function setRotateEnabled(on, goalCFrame)
    local mode = Config.RotateMode or "CFrame"
    if mode == "Align" then
        if alignOrientation then
            alignOrientation.Enabled = on
            if on and goalCFrame then
                alignOrientation.CFrame = goalCFrame
            end
        end
    elseif mode == "Align2" then
        if align2Orientation then
            align2Orientation.Enabled = on
        end
    elseif mode == "BodyGyro" then
        if bodyGyro then
            if on and goalCFrame then
                bodyGyro.MaxTorque = Config.GyroMaxTorque or Vector3.new(0, 1e9, 0)
                bodyGyro.CFrame = goalCFrame
            else
                bodyGyro.MaxTorque = Vector3.zero
            end
        end
    elseif mode == "AngularVel" then
        if angVelConstraint then
            angVelConstraint.Enabled = on
            if not on then
                angVelConstraint.AngularVelocity = Vector3.zero
            end
        end
    elseif mode == "Torque" then
        if torqueConstraint then
            torqueConstraint.Enabled = on
            if not on then
                torqueConstraint.Torque = Vector3.zero
            end
        end
    elseif mode == "Motor6D" then
        if not on then
            restoreMotor6D()
        end
    elseif mode == "Assembly" then
        if not on and rootPart then
            local av = rootPart.AssemblyAngularVelocity
            rootPart.AssemblyAngularVelocity = Vector3.new(av.X, 0, av.Z)
        end
    end
end

local function clearSticky()
    stickyTarget = nil
end

local function hardClearLock()
    lockedTarget = nil
    activeLockKey = nil
    lockExpireTime = 0
    lockStartTime = 0
    isHoldingMouse = false
    currentLockSource = nil
    smoothedAimPos, smoothedAimTarget = nil, nil
    for _, conn in pairs(grabConnections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(grabConnections)
    setRotateEnabled(false)
    if humanoid and humanoid.Parent and not stickyTarget then
        pcall(function() humanoid.AutoRotate = true end)
    end
end

local function clearPriority()
    priorityTarget = nil
end

local function setupCharacter(char)
    character = char
    humanoid = char:WaitForChild("Humanoid")
    rootPart = char:WaitForChild("HumanoidRootPart")
    hardClearLock()
    clearPriority()
    clearSticky()
    setupRotateInstances()
    isHoldingQ, qLocked, isTeleporting = false, false, false
    disableUntil, lastState = 0, nil
    table.clear(targetHistory)
    skill3TPToken += 1
end

player.CharacterAdded:Connect(setupCharacter)
if player.Character then
    setupCharacter(player.Character)
end

local function isGrabMarker(name)
    if type(name) ~= "string" then return false end
    local lower = string.lower(name)
    if string.find(lower, "weapon", 1, true)
        or string.find(lower, "tool", 1, true)
        or string.find(lower, "#", 1, true) then
        return false
    end
    for _, marker in ipairs(GRAB_MARKERS) do
        if name == marker then return true end
    end
    return false
end

local function watchTargetForGrab(target)
    for _, conn in pairs(grabConnections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(grabConnections)
    if not target or not target.Parent then return end
    local ok, kids = pcall(function() return target:GetChildren() end)
    if ok and kids then
        for _, child in ipairs(kids) do
            if isGrabMarker(child.Name) then
                hardClearLock()
                return
            end
        end
    end
    table.insert(grabConnections, target.ChildAdded:Connect(function(child)
        if isGrabMarker(child.Name) then hardClearLock() end
    end))
    table.insert(grabConnections, target.AncestryChanged:Connect(function(_, parent)
        if not parent then hardClearLock() end
    end))
end

local function isSelfRagdolled(lenient)
    if not character or not humanoid then return true end
    local state = humanoid:GetState()
    if state == Enum.HumanoidStateType.Physics
        or state == Enum.HumanoidStateType.Ragdoll then
        return true
    end
    if not lenient and state == Enum.HumanoidStateType.FallingDown then
        return true
    end
    if character:FindFirstChild("Ragdoll") or character:FindFirstChild("Ragdolled") then return true end
    if character:GetAttribute("Ragdoll") == true or character:GetAttribute("Ragdolled") == true then return true end
    return false
end

local function isActiveFlag(val)
    if not val then return false end
    if val:IsA("BoolValue") then return val.Value == true end
    if val:IsA("IntValue") or val:IsA("NumberValue") then return val.Value > 0 end
    return false
end

local function isTargetCountering(model)
    if not Config.IgnoreActiveCounter then return false end
    if not model or not model.Parent then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    for _, name in ipairs(COUNTER_NAMES) do
        if model:GetAttribute(name) == true then return true end
        if hum and hum:GetAttribute(name) == true then return true end
        if isActiveFlag(model:FindFirstChild(name)) then return true end
        if hum and isActiveFlag(hum:FindFirstChild(name)) then return true end
    end
    return false
end

local function isStunned()
    if not character or not humanoid then return false end
    for _, name in ipairs(STUN_NAMES) do
        if character:GetAttribute(name) == true or humanoid:GetAttribute(name) == true then return true end
        local val = character:FindFirstChild(name) or humanoid:FindFirstChild(name)
        if isActiveFlag(val) then return true end
    end
    return false
end

local function isInIgnoredFolder(model)
    local current = model and model.Parent
    for _ = 1, 8 do
        if not current or current == workspace then break end
        if IGNORE_FOLDERS[current.Name] then return true end
        current = current.Parent
    end
    return false
end

local function isAllyModel(model)
    if not Config.IgnoreAllies.Enabled then return false end
    local plr = Players:GetPlayerFromCharacter(model)
    if not plr then return false end
    if Config.IgnoreAllies.UseUserId then
        return allyUserIdSet[plr.UserId] == true
    end
    return allyNameSet[string.lower(plr.Name)] == true
end

local function isInFront(hrp)
    if not Config.LockOnlyInFront then return true end
    if not rootPart or not hrp then return false end
    local flatLook = Vector3.new(rootPart.CFrame.LookVector.X, 0, rootPart.CFrame.LookVector.Z)
    if flatLook.Magnitude < 1e-3 then return true end
    flatLook = flatLook.Unit
    local offset = hrp.Position - rootPart.Position
    local flatDir = Vector3.new(offset.X, 0, offset.Z)
    if flatDir.Magnitude < 1e-3 then return true end
    flatDir = flatDir.Unit
    return flatLook:Dot(flatDir) >= math.cos(math.rad(Config.FrontAngle * 0.5))
end

local function isWithinDistance(dist)
    if dist > Config.MaxLockDistance then return false end
    if Config.MinLockDistance > 0 and dist < Config.MinLockDistance then return false end
    return true
end

local function isPlayerCharacter(model)
    return Players:GetPlayerFromCharacter(model) ~= nil
end

local function isValidTarget(model)
    if not model or not model:IsA("Model") or model == character then return false end
    if not model.Parent then return false end
    if isInIgnoredFolder(model) then return false end
    if isAllyModel(model) then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local hrp = getRoot(model)
    if not hrp then return false end
    local pos = hrp.Position
    if pos ~= pos or pos.Magnitude > 100000 then return false end
    if not hrp:IsDescendantOf(model) then return false end
    if isTargetCountering(model) then return false end
    return true
end

local function findPart(model, names)
    for _, n in ipairs(names) do
        local p = model:FindFirstChild(n, true)
        if p and p:IsA("BasePart") then return p end
    end
    return nil
end

local function getChestPart(model)
    return findPart(model, {"UpperTorso", "Torso", "LowerTorso"})
end

local function getAimModeForSource(source)
    local map = Config.AimPointBySource
    if not map then return "Root" end
    return map[source] or map.default or "Root"
end

local function getAimOffsetForSource(source)
    local map = Config.AimOffsetBySource
    if not map then return 0 end
    local v = map[source]
    if v == nil then v = map.default end
    return v or 0
end

local function getAimWorldPosition(model, hrp, source)
    local mode = getAimModeForSource(source)
    local dist = getAimOffsetForSource(source)
    local cf = hrp.CFrame
    local pos = hrp.Position
    if mode == "Torso" or mode == "Chest" or mode == "Body" then
        local torso = getChestPart(model)
        if torso then return torso.Position end
        return pos
    end
    if mode == "Root" then
        return pos
    elseif mode == "Head" then
        local head = findPart(model, {"Head"})
        return head and head.Position or (pos + Vector3.new(0, 1.5, 0))
    elseif mode == "AboveHead" then
        local head = findPart(model, {"Head"})
        local base = head and head.Position or (pos + Vector3.new(0, 1.5, 0))
        local extra = (dist ~= 0 and dist) or (Config.AboveHeadHeight or 1.2)
        return base + Vector3.new(0, extra, 0)
    elseif mode == "Front" then
        local base = getChestPart(model) or hrp
        return base.Position + base.CFrame.LookVector * dist
    elseif mode == "Back" then
        local base = getChestPart(model) or hrp
        return base.Position - base.CFrame.LookVector * dist
    elseif mode == "Left" then
        local base = getChestPart(model) or hrp
        return base.Position - base.CFrame.RightVector * dist
    elseif mode == "Right" then
        local base = getChestPart(model) or hrp
        return base.Position + base.CFrame.RightVector * dist
    elseif mode == "LeftArm" then
        local arm = findPart(model, {"LeftHand", "Left Arm", "LeftLowerArm", "LeftUpperArm"})
        return arm and arm.Position or (pos - cf.RightVector * math.max(dist, 1.2))
    elseif mode == "RightArm" then
        local arm = findPart(model, {"RightHand", "Right Arm", "RightLowerArm", "RightUpperArm"})
        return arm and arm.Position or (pos + cf.RightVector * math.max(dist, 1.2))
    end
    return pos
end

local function getPingSec()
    local ok, v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and typeof(v) == "number" then return v / 1000 end
    return 0.011
end

local function getHistoryVelocity(model, hrp, dt)
    local now = tick()
    local entry = targetHistory[model]
    if not entry then
        targetHistory[model] = {pos = hrp.Position, t = now, vel = Vector3.zero}
        return Vector3.zero
    end
    local deltaPos = hrp.Position - entry.pos
    local deltaT = math.max(now - entry.t, 1/240)
    if deltaPos.Magnitude > 120 then
        targetHistory[model] = {pos = hrp.Position, t = now, vel = entry.vel}
        return entry.vel
    end
    local rawVel = deltaPos / deltaT
    local smoothed = entry.vel:Lerp(rawVel, math.clamp(dt * Config.PredictionHistorySmoothing, 0, 1))
    targetHistory[model] = {pos = hrp.Position, t = now, vel = smoothed}
    return smoothed
end

local function applyVelocityPrediction(worldPos, hrp, model, dt)
    if not Config.UsePrediction then return worldPos end
    if not model or not hrp then return worldPos end
    local vel = getHistoryVelocity(model, hrp, dt)
    if vel.Magnitude < 2 then return worldPos end
    if vel.Magnitude > Config.PredictionMaxSpeed then
        vel = vel.Unit * Config.PredictionMaxSpeed
    end
    local ping = Config.UsePingCompensation and getPingSec() or 0
    local strength = Config.PredictionStrength + ping * Config.PingCompensationMultiplier
    return worldPos + vel * strength
end

local function smoothAim(model, aimPos)
    local alpha = Config.AimSmooth or 0
    if alpha <= 0 or alpha >= 0.999 then
        smoothedAimPos = aimPos
        smoothedAimTarget = model
        return aimPos
    end
    if smoothedAimTarget ~= model or not smoothedAimPos then
        smoothedAimPos = aimPos
        smoothedAimTarget = model
        return aimPos
    end
    smoothedAimPos = smoothedAimPos:Lerp(aimPos, math.clamp(alpha, 0.05, 1))
    return smoothedAimPos
end

local function scoreTarget(model, dist)
    local score = dist
    if Config.TargetPriority == "Players" then
        if isPlayerCharacter(model) then score -= 10000 end
    elseif Config.TargetPriority == "NPC" then
        if not isPlayerCharacter(model) then score -= 10000 end
    end
    return score
end

local function considerTarget(model, myPos, best, bestScore)
    if not isValidTarget(model) then return best, bestScore end
    local hrp = getRoot(model)
    if not hrp then return best, bestScore end
    local dist = (myPos - hrp.Position).Magnitude
    if not isWithinDistance(dist) or not isInFront(hrp) then return best, bestScore end
    local s = scoreTarget(model, dist)
    if s < bestScore then return model, s end
    return best, bestScore
end

local function scanForTargets(parent, myPos, best, bestScore, depth)
    if depth > 5 or not parent or IGNORE_FOLDERS[parent.Name] then return best, bestScore end
    local ok, children = pcall(function() return parent:GetChildren() end)
    if not ok or not children then return best, bestScore end
    for _, child in ipairs(children) do
        if child:IsA("Model") and child ~= character then
            best, bestScore = considerTarget(child, myPos, best, bestScore)
            best, bestScore = scanForTargets(child, myPos, best, bestScore, depth + 1)
        elseif child:IsA("Folder") or child:IsA("Configuration") or child:IsA("WorldModel") then
            if not IGNORE_FOLDERS[child.Name] then
                best, bestScore = scanForTargets(child, myPos, best, bestScore, depth + 1)
            end
        end
    end
    return best, bestScore
end

local function getClosestTarget()
    if not rootPart or not rootPart.Parent then return nil end
    local myPos = rootPart.Position
    local best, bestScore = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            best, bestScore = considerTarget(p.Character, myPos, best, bestScore)
        end
    end
    if best and (bestScore < 200) then
        return best
    end
    local folders = {
        workspace:FindFirstChild("Characters"),
        workspace:FindFirstChild("Live"),
        workspace:FindFirstChild("Entities"),
        workspace:FindFirstChild("Mobs"),
        workspace:FindFirstChild("NPCs"),
        workspace:FindFirstChild("Units"),
        workspace:FindFirstChild("Dummy"),
        workspace:FindFirstChild("Dummies"),
    }
    for _, folder in ipairs(folders) do
        if folder then
            best, bestScore = scanForTargets(folder, myPos, best, bestScore, 0)
        end
    end
    best, bestScore = scanForTargets(workspace, myPos, best, bestScore, 0)
    return best
end

local function getTargetUnderMouse(maxDistance, aimRadiusPx)
    if not rootPart or not rootPart.Parent then return nil end
    local aim2D
    if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
        aim2D = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    else
        aim2D = UserInputService:GetMouseLocation()
    end
    local best, bestScore = nil, aimRadiusPx or 220
    local myPos = rootPart.Position
    local maxDist = maxDistance or Config.MaxLockDistance
    local function consider(model)
        if not isValidTarget(model) then return end
        local hrp = getRoot(model)
        if not hrp then return end
        local worldDist = (myPos - hrp.Position).Magnitude
        if not isWithinDistance(worldDist) or worldDist > maxDist or not isInFront(hrp) then return end
        local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
        if not onScreen then return end
        local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - aim2D).Magnitude
        if dist2D < bestScore then
            bestScore, best = dist2D, model
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            consider(p.Character)
        end
    end
    local function scanMouse(parent, depth)
        if depth > 5 or not parent or IGNORE_FOLDERS[parent.Name] then return end
        local ok, children = pcall(function() return parent:GetChildren() end)
        if not ok or not children then return end
        for _, child in ipairs(children) do
            if child:IsA("Model") then
                consider(child)
                scanMouse(child, depth + 1)
            elseif child:IsA("Folder") or child:IsA("Configuration") then
                scanMouse(child, depth + 1)
            end
        end
    end
    local chars = workspace:FindFirstChild("Characters")
    if chars then scanMouse(chars, 0) end
    scanMouse(workspace, 0)
    return best
end

local function tryActivateLock(source)
    if not lockEnabled or isSelfRagdolled(true) then return false end
    local target
    if stickyTarget and isValidTarget(stickyTarget) then
        target = stickyTarget
    elseif priorityTarget and isValidTarget(priorityTarget) then
        local hrp = getRoot(priorityTarget)
        if hrp and isWithinDistance((rootPart.Position - hrp.Position).Magnitude) and isInFront(hrp) then
            target = priorityTarget
        end
    end
    target = target or getClosestTarget()
    if not target then return false end
    lockedTarget = target
    currentLockSource = source or "skill"
    if humanoid then humanoid.AutoRotate = false end
    watchTargetForGrab(target)
    return true
end

local function shouldRetarget()
    if stickyTarget and isValidTarget(stickyTarget) then return false end
    if priorityTarget and isValidTarget(priorityTarget) then return false end
    if currentLockSource == "block" then return Config.BlockRetargetClosest end
    if currentLockSource == "skill" then return Config.SkillRetargetClosest end
    if currentLockSource == "mouse" then return Config.MouseRetargetClosest end
    return false
end

local function isActivelyHolding()
    return activeLockKey ~= nil or isHoldingMouse == true
end

local function isAerialState(state)
    return state == Enum.HumanoidStateType.Freefall
        or state == Enum.HumanoidStateType.Flying
        or state == Enum.HumanoidStateType.Jumping
        or state == Enum.HumanoidStateType.PlatformStanding
end

local function teleportBehindTarget(target)
    if not rootPart or not target or not isValidTarget(target) then return end
    local tRoot = getRoot(target)
    if not tRoot then return end
    local cfg = Config.Skill3BehindTP
    local behindPos = tRoot.Position - tRoot.CFrame.LookVector * (cfg.Distance or 3.2)
        + Vector3.new(0, cfg.Height or 0, 0)
    local goalCF
    if cfg.FaceTarget ~= false then
        goalCF = CFrame.lookAt(behindPos, tRoot.Position)
    else
        goalCF = CFrame.new(behindPos) * (rootPart.CFrame - rootPart.CFrame.Position)
    end
    local smooth = cfg.Smooth or 0
    if smooth <= 0 then
        rootPart.CFrame = goalCF
    else
        isTeleporting = true
        local tw = TweenService:Create(rootPart, TweenInfo.new(smooth, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            CFrame = goalCF
        })
        tw:Play()
        tw.Completed:Connect(function() isTeleporting = false end)
    end
end

local function scheduleSkill3BehindTP()
    local cfg = Config.Skill3BehindTP
    if not cfg or not cfg.Enabled then return end
    skill3TPToken += 1
    local token = skill3TPToken
    task.delay(cfg.Delay or 0.15, function()
        if token ~= skill3TPToken then return end
        if not lockEnabled or not rootPart then return end
        local target = lockedTarget
        if stickyTarget and isValidTarget(stickyTarget) then
            target = stickyTarget
        end
        if target and isValidTarget(target) then
            teleportBehindTarget(target)
        end
    end)
end

local function trySmoothBehind()
    if not Config.EnableTeleport or isTeleporting then return end
    if tick() - lastBehindTime < Config.BehindCooldown then return end
    if not rootPart or not lockedTarget or not isValidTarget(lockedTarget) then return end
    local tRoot = getRoot(lockedTarget)
    if not tRoot then return end
    if (rootPart.Position - tRoot.Position).Magnitude > Config.CloseTeleportRange then return end
    local behindPos = tRoot.Position - tRoot.CFrame.LookVector * Config.BehindDistance
        + Vector3.new(0, Config.BehindHeight, 0)
    isTeleporting = true
    lastBehindTime = tick()
    local tween = TweenService:Create(rootPart, TweenInfo.new(Config.BehindSmoothTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        CFrame = CFrame.lookAt(behindPos, tRoot.Position)
    })
    tween:Play()
    tween.Completed:Connect(function() isTeleporting = false end)
end

local function isLockKey(key)
    if key == (Config.BlockKey or Enum.KeyCode.F) then return true end
    for _, k in ipairs(Config.LockKeys) do
        if k == key then return true end
    end
    return false
end

local function isBlockKey(key)
    return key == (Config.BlockKey or Enum.KeyCode.F)
end

local function isPriorityKey(key)
    if key == Config.PriorityKey then return true end
    if Config.PriorityAlsoRightAlt and key == Enum.KeyCode.RightAlt then return true end
    return false
end

local function resolveAimSource()
    if stickyTarget then
        if isActivelyHolding() then
            return currentLockSource or "skill"
        elseif lockExpireTime > 0 and tick() < lockExpireTime then
            return currentLockSource or "sticky"
        end
        return "sticky"
    end
    return currentLockSource or "default"
end

local function applyRotation(goal, flatLook, flatTo, dt, angleDeg)
    setRotateEnabled(false)
    if Config.UseSmoothTurn then
        local alpha = 1 - math.exp(-dt / math.max(Config.Smoothness, 0.01))
        rootPart.CFrame = rootPart.CFrame:Lerp(goal, math.clamp(alpha, 0, 1))
    else
        rootPart.CFrame = goal
    end
end

-- ======================================================
-- ENABLE / DISABLE LOCK
-- ======================================================
local onLockEnabledChanged

local function setLockEnabled(v)
    lockEnabled = v
    if not lockEnabled then
        hardClearLock()
        clearSticky()
        skill3TPToken += 1
        if humanoid and humanoid.Parent then
            pcall(function() humanoid.AutoRotate = true end)
        end
    else
        if humanoid and humanoid.Parent then
            pcall(function() humanoid.AutoRotate = false end)
        end
    end
    if onLockEnabledChanged then
        onLockEnabledChanged(lockEnabled)
    end
end

-- ======================================================
-- INPUTS
-- ======================================================
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Config.ToggleKey then
        return
    end
    if input.KeyCode == Config.EnableLockKey then
        setLockEnabled(not lockEnabled)
        return
    end
    if not lockEnabled or isSelfRagdolled(true) then return end
    if input.KeyCode == Config.StickyLockKey then
        if stickyTarget and isValidTarget(stickyTarget) then
            clearSticky()
            if not activeLockKey and not isHoldingMouse and (not lockExpireTime or lockExpireTime <= 0) then
                lockedTarget = nil
                setRotateEnabled(false)
                if humanoid then humanoid.AutoRotate = true end
            end
            print("Sticky OFF")
            return
        end
        local target = getTargetUnderMouse(Config.PriorityMaxDistance, Config.PriorityAimRadiusPx)
        if not target then
            print("Nenhum alvo sob o mouse")
            return
        end
        stickyTarget = target
        lockedTarget = target
        currentLockSource = "sticky"
        smoothedAimPos, smoothedAimTarget = nil, nil
        if humanoid then humanoid.AutoRotate = false end
        watchTargetForGrab(target)
        print("Sticky ON -> " .. target.Name)
        return
    end
    if isPriorityKey(input.KeyCode) then
        if priorityTarget and isValidTarget(priorityTarget) then
            clearPriority()
            return
        end
        local target = getTargetUnderMouse(Config.PriorityMaxDistance, Config.PriorityAimRadiusPx)
        if target then
            priorityTarget = target
            lockedTarget = target
            currentLockSource = "priority"
            if humanoid then humanoid.AutoRotate = false end
            watchTargetForGrab(target)
            lockExpireTime = tick() + 0.4
            activeLockKey = nil
        end
        return
    end
    if isLockKey(input.KeyCode) then
        activeLockKey = input.KeyCode
        lockStartTime = tick()
        lockExpireTime = 0
        tryActivateLock(isBlockKey(input.KeyCode) and "block" or "skill")
        local s3 = Config.Skill3BehindTP
        if s3 and s3.Enabled and input.KeyCode == (s3.Key or Enum.KeyCode.Three) then
            scheduleSkill3BehindTP()
        end
        return
    end
    if Config.UseMouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1 then
        isHoldingMouse = true
        mousePressTime = tick()
        lockExpireTime = 0
        tryActivateLock("mouse")
        return
    end
    if input.KeyCode == Config.BehindKey then
        isHoldingQ = true
        qHoldStart = tick()
        qLocked = false
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if isHoldingMouse then
            local held = tick() - mousePressTime
            isHoldingMouse = false
            if lockEnabled then
                if held >= Config.MouseHoldThreshold then
                    if not stickyTarget then hardClearLock() end
                    activeLockKey = nil
                else
                    lockExpireTime = tick() + Config.MouseClickLockDuration
                    currentLockSource = "mouse"
                end
            end
        end
        return
    end
    if not lockEnabled then return end
    if input.KeyCode == Config.StickyLockKey then return end
    if isPriorityKey(input.KeyCode) then return end
    if activeLockKey and activeLockKey == input.KeyCode then
        if (tick() - lockStartTime) >= Config.HoldThreshold then
            if not stickyTarget then hardClearLock() end
            activeLockKey = nil
        else
            activeLockKey = nil
            lockExpireTime = tick() + Config.ClickLockDuration
        end
        return
    end
    if input.KeyCode == Config.BehindKey then
        isHoldingQ, qLocked = false, false
    end
end)

-- ======================================================
-- NUCLEO TRIPLO INSTANTANEO
-- ======================================================
local function doLock(dt)
    if not lockEnabled or not rootPart or not humanoid or not humanoid.Parent then return end
    if isSelfRagdolled() then
        if lockedTarget and not stickyTarget then hardClearLock() end
        setRotateEnabled(false)
        return
    end
    local currentState = humanoid:GetState()
    local velocity = rootPart.AssemblyLinearVelocity.Magnitude
    local aerial = isAerialState(currentState)
    if lastState then
        local wasAerial = isAerialState(lastState)
        local nowNormal = currentState == Enum.HumanoidStateType.Running
            or currentState == Enum.HumanoidStateType.Landed
            or currentState == Enum.HumanoidStateType.RunningNoPhysics
            or currentState == Enum.HumanoidStateType.GettingUp
        if wasAerial and nowNormal then
            disableUntil = 0
            if lockedTarget and isValidTarget(lockedTarget) then
                humanoid.AutoRotate = false
            end
        end
    end
    lastState = currentState
    if stickyTarget then
        if isValidTarget(stickyTarget) then
            lockedTarget = stickyTarget
            if not isActivelyHolding() and not (lockExpireTime > 0 and tick() < lockExpireTime) then
                currentLockSource = "sticky"
            end
        else
            clearSticky()
            if not activeLockKey and not isHoldingMouse then
                lockedTarget = nil
                setRotateEnabled(false)
                if humanoid then humanoid.AutoRotate = true end
            end
        end
    end
    if isHoldingQ then
        if not qLocked and (tick() - qHoldStart) >= Config.BehindHoldDelay then
            qLocked = true
            tryActivateLock("q")
            lockExpireTime = tick() + 1.5
            activeLockKey = nil
        end
        if qLocked and lockedTarget then
            trySmoothBehind()
        end
    end
    local shouldHaveLock = activeLockKey ~= nil or isHoldingMouse or stickyTarget ~= nil
    if not shouldHaveLock and lockExpireTime > 0 then
        if tick() < lockExpireTime then
            shouldHaveLock = true
        else
            if not stickyTarget then
                lockedTarget, currentLockSource, lockExpireTime = nil, nil, 0
                setRotateEnabled(false)
                pcall(function() humanoid.AutoRotate = true end)
            else
                lockExpireTime = 0
                currentLockSource = "sticky"
            end
        end
    end
    if not shouldHaveLock then
        if lockedTarget and not (isHoldingQ and qLocked) and not stickyTarget then
            lockedTarget, currentLockSource, activeLockKey, isHoldingMouse = nil, nil, nil, false
            setRotateEnabled(false)
            pcall(function() humanoid.AutoRotate = true end)
        end
        return
    end
    if shouldRetarget() and not aerial and not stickyTarget and tick() - lastRetarget >= Config.UltraScanInterval then
        lastRetarget = tick()
        local closest = getClosestTarget()
        if closest and closest ~= lockedTarget then
            lockedTarget = closest
            smoothedAimPos, smoothedAimTarget = nil, nil
            watchTargetForGrab(closest)
        end
    end
    if stickyTarget and isValidTarget(stickyTarget) then
        lockedTarget = stickyTarget
    elseif priorityTarget and isValidTarget(priorityTarget) and not stickyTarget then
        lockedTarget = priorityTarget
    elseif priorityTarget and not isValidTarget(priorityTarget) then
        clearPriority()
    end
    if lockedTarget and isValidTarget(lockedTarget) then
        local hrpCheck = getRoot(lockedTarget)
        if hrpCheck then
            local d = (rootPart.Position - hrpCheck.Position).Magnitude
            if not isWithinDistance(d) then
                if stickyTarget ~= lockedTarget then lockedTarget = nil end
            elseif Config.LockOnlyInFront and not isInFront(hrpCheck) and not isActivelyHolding() and not stickyTarget then
                lockedTarget = nil
            end
        end
    end
    if not lockedTarget or not isValidTarget(lockedTarget) then
        if stickyTarget then return end
        if aerial then lockedTarget = nil return end
        local newTarget = getClosestTarget()
        if newTarget then
            lockedTarget = newTarget
            smoothedAimPos, smoothedAimTarget = nil, nil
            watchTargetForGrab(newTarget)
        else
            return
        end
    end
    if isTargetCountering(lockedTarget) and not aerial and not stickyTarget then
        local other = getClosestTarget()
        if other and other ~= lockedTarget then
            lockedTarget = other
            smoothedAimPos, smoothedAimTarget = nil, nil
            watchTargetForGrab(other)
        end
    end
    if not lockedTarget or not lockedTarget.Parent then return end
    local okKids, kids = pcall(function() return lockedTarget:GetChildren() end)
    if okKids and kids then
        for _, child in ipairs(kids) do
            if isGrabMarker(child.Name) then
                if stickyTarget == lockedTarget then clearSticky() end
                hardClearLock()
                return
            end
        end
    end
    local tRoot = getRoot(lockedTarget)
    if not tRoot then return end
    local tHum = lockedTarget:FindFirstChildOfClass("Humanoid")
    if not tHum or tHum.Health <= 0 then return end
    local source = resolveAimSource()
    local rawAim = applyVelocityPrediction(getAimWorldPosition(lockedTarget, tRoot, source), tRoot, lockedTarget, dt)
    if rawAim ~= rawAim then return end
    local aimPos = smoothAim(lockedTarget, rawAim)
    local unsafe = false
    if Config.StrongValidation then
        if isActivelyHolding() or stickyTarget then
            unsafe = rootPart.CFrame.UpVector.Y < 0.4
        else
            unsafe = isStunned() or rootPart.CFrame.UpVector.Y < 0.65
        end
    else
        unsafe = isStunned()
            or currentState == Enum.HumanoidStateType.Physics
            or currentState == Enum.HumanoidStateType.Ragdoll
            or currentState == Enum.HumanoidStateType.FallingDown
            or velocity > Config.MaxVelocityToLock
            or rootPart.CFrame.UpVector.Y < 0.65
    end
    if unsafe then
        disableUntil = math.max(disableUntil, tick() + Config.GraceTimeAfterStun)
    end
    if tick() < disableUntil and not ((Config.StrongValidation and isActivelyHolding()) or stickyTarget) then
        setRotateEnabled(false)
        pcall(function() humanoid.AutoRotate = true end)
        return
    end
    pcall(function() humanoid.AutoRotate = false end)
    local myPos = rootPart.Position
    local targetPos = Vector3.new(aimPos.X, myPos.Y, aimPos.Z)
    local look = rootPart.CFrame.LookVector
    local flatLook = Vector3.new(look.X, 0, look.Z)
    if flatLook.Magnitude > 1e-3 then
        flatLook = flatLook.Unit
    else
        return
    end
    local flatTo = Vector3.new(targetPos.X - myPos.X, 0, targetPos.Z - myPos.Z)
    if flatTo.Magnitude < 1e-3 then return end
    flatTo = flatTo.Unit
    local angleDeg = math.deg(math.acos(math.clamp(flatLook:Dot(flatTo), -1, 1)))
    if Config.InstantBehindSnap and angleDeg > 90 then
        local goal = CFrame.lookAt(myPos, targetPos)
        rootPart.CFrame = goal
        return
    end
    local deadzone = Config.TurnDeadzoneDegrees or 0
    if (Config.ZeroDeadzoneWhenHolding and isActivelyHolding()) or stickyTarget then
        deadzone = 0
    end
    if angleDeg < deadzone then return end
    local goal = CFrame.lookAt(myPos, targetPos)
    applyRotation(goal, flatLook, flatTo, dt, angleDeg)
end

pcall(function()
    RunService:UnbindFromRenderStep("CharacterLock_Triple")
end)
RunService:BindToRenderStep("CharacterLock_Triple", Enum.RenderPriority.Camera.Value + 1, doLock)
RunService.Heartbeat:Connect(doLock)
if RunService.PostSimulation then
    RunService.PostSimulation:Connect(doLock)
else
    RunService.Stepped:Connect(doLock)
end
if RunService.PreRender then
    RunService.PreRender:Connect(doLock)
end

print("Character Lock TRIPLO INSTANTANEO | CFrame 3x | Root 360")

