section(pageSettings, "LOCK KEYS", "Custom keys that activate the regular lock. Add or remove any key.")

local function isKeyInLockKeys(key)
    for _, k in ipairs(Config.LockKeys) do
        if k == key then return true end
    end
    return false
end

local lockKeysList = new("Frame", {
    Size = UDim2.new(1, -4, 0, 0),
    AutomaticSize = Enum.AutomaticSize.Y,
    BackgroundTransparency = 1,
}, pageSettings)
new("UIListLayout", {
    Padding = UDim.new(0, 6),
    SortOrder = Enum.SortOrder.LayoutOrder,
}, lockKeysList)

local rebuildLockKeysList

local function addKeyRow(key, order)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = TurboTheme.Panel2,
        BorderSizePixel = 0,
        LayoutOrder = order,
    }, lockKeysList)
    corner(row, 8)

    local t = label(row, key.Name, 12, TurboTheme.Text, true)
    t.Position = UDim2.fromOffset(12, 0)
    t.Size = UDim2.new(1, -60, 1, 0)

    local removeBtn = new("TextButton", {
        Size = UDim2.fromOffset(28, 24),
        Position = UDim2.new(1, -38, 0.5, -12),
        BackgroundColor3 = TurboTheme.Red,
        BorderSizePixel = 0,
        Text = "✕",
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
    }, row)
    corner(removeBtn, 6)
    turboConnect(removeBtn.MouseButton1Click, function()
        for i, k in ipairs(Config.LockKeys) do
            if k == key then
                table.remove(Config.LockKeys, i)
                break
            end
        end
        rebuildLockKeysList()
    end)
end

rebuildLockKeysList = function()
    for _, child in ipairs(lockKeysList:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    for i, key in ipairs(Config.LockKeys) do
        addKeyRow(key, i)
    end
end
rebuildLockKeysList()

